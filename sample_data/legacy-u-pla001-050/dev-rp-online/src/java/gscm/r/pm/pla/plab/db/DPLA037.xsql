				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CASH_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_EQ_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COGS_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_EQ_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COO_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_EQ_COST_ST_O
