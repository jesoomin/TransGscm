				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(M' || WORK_YM || '_CASH_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (M' || WORK_YM || '_SALE_AMT_SALE_PLN - M' || WORK_YM || '_CASH_COST_YR_COST) / M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN END END AS M' || WORK_YM || '_CASH_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(M' || WORK_YM || '_SALE_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (M' || WORK_YM || '_SALE_AMT_SALE_PLN - M' || WORK_YM || '_COGS_COST_YR_COST) / M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN END END AS M' || WORK_YM || '_SALE_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(M' || WORK_YM || '_SALES_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (M' || WORK_YM || '_SALE_AMT_SALE_PLN - M' || WORK_YM || '_COO_COST_YR_COST) / M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN END END AS M' || WORK_YM || '_SALES_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_EQ_PROF_ST_O
				/*DIE 수익성*/
