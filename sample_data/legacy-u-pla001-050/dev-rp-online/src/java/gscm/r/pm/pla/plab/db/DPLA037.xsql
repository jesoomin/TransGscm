				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_CASH_COST_YR_COST / M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN END END AS M' || WORK_YM || '_CASH_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_DIE_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_COGS_COST_YR_COST / M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN END END AS M' || WORK_YM || '_COGS_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_DIE_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_COO_COST_YR_COST / M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN END END AS M' || WORK_YM || '_COO_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_DIE_COST_ST_O
				/*제품 원가*/
				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_VAR_COST_YR_COST / M' || WORK_YM || '_ORG_QTY_SALE_PLN END END AS M' || WORK_YM || '_VAR_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_CASH_COST_YR_COST / M' || WORK_YM || '_ORG_QTY_SALE_PLN END END AS M' || WORK_YM || '_CASH_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_COGS_COST_YR_COST / M' || WORK_YM || '_ORG_QTY_SALE_PLN END END AS M' || WORK_YM || '_COGS_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_COO_COST_YR_COST / M' || WORK_YM || '_ORG_QTY_SALE_PLN END END AS M' || WORK_YM || '_COO_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_PROD_COST_ST_O
				/*장당 수익성*/
