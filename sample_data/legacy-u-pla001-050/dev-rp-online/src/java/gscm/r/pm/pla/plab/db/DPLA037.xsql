				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COGS_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_DIE_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COO_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_DIE_COST_ST_O
				/*제품 원가*/
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_VAR_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CASH_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COGS_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COO_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_PROD_COST_ST_O
				/*장당 수익성*/
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_CNTRB_PROF_WF_SLS_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST) / H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_WF_SLS_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_CASH_PROF_WF_SLS_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST) / H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CASH_PROF_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_WF_SLS_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_PROF_WF_SLS_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST) / H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_SALE_PROF_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_WF_SLS_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_COO_COST_YR_COST) / H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_WF_SLS_PROF_ST_O
				/*EQ 수익성*/
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_CNTRB_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST) / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_CASH_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST) / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CASH_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST) / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_SALE_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_COO_COST_YR_COST) / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_EQ_PROF_ST_O
				/*DIE 수익성*/
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_CNTRB_PROF_DIE_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST) / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_DIE_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_CASH_PROF_DIE_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST) / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CASH_PROF_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_DIE_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_PROF_DIE_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST) / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_SALE_PROF_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_DIE_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_COO_COST_YR_COST) / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_DIE_PROF_ST_O
				/*제품 수익성*/
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_CNTRB_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST) / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_PROD_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_CASH_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST) / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CASH_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_PROD_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST) / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_SALE_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_PROD_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_COO_COST_YR_COST) / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_PROD_PROF_ST_O
			]]>
		</isNotEqual>
			<![CDATA[				
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_YR_COST_ST_O
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_YR_COST_ST_O
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_YR_COST_ST_O
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COO_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_YR_COST_ST_O
			]]>
		<isEqual property="SEARCH_TYPE" compareValue="ODD">
			<isEqual property="CHK_SUBTOTAL" compareValue="Y">	
				<![CDATA[
				/*영업이익률 MAX*/
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF,0) = 0 THEN 0 ELSE NVL( H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF / H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF * 100, 0) END ELSE CASE WHEN NVL( H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF, 0) = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF/ H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(,NVL(((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF( H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0)) - ( H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / NULLIF( H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0))) / NULLIF((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_WF_ST_O2				
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_EQ_PROF,0) = 0 THEN 0 ELSE NVL( H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF / H' || WORK_YEAR_HALF || '_SALE_EQ_PROF * 100, 0) END ELSE CASE WHEN NVL( H' || WORK_YEAR_HALF || '_SALE_EQ_PROF, 0) = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF/ H' || WORK_YEAR_HALF || '_SALE_EQ_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_EQ_ST_O1
				, LISTAGG(,NVL(((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF( H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0)) - ( H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / NULLIF( H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0))) / NULLIF((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_EQ_ST_O2				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_DIE_PROF,0) = 0 THEN 0 ELSE NVL( H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF / H' || WORK_YEAR_HALF || '_SALE_DIE_PROF * 100, 0) END ELSE CASE WHEN NVL( H' || WORK_YEAR_HALF || '_SALE_DIE_PROF, 0) = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF/ H' || WORK_YEAR_HALF || '_SALE_DIE_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_DIE_ST_O1
				, LISTAGG(,NVL(((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF( H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0)) - ( H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / NULLIF( H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0))) / NULLIF((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_DIE_ST_O2				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_PROD_PROF,0) = 0 THEN 0 ELSE NVL( H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF / H' || WORK_YEAR_HALF || '_SALE_PROD_PROF * 100, 0) END ELSE CASE WHEN NVL( H' || WORK_YEAR_HALF || '_SALE_PROD_PROF, 0) = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF/ H' || WORK_YEAR_HALF || '_SALE_PROD_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_PROD_ST_O1
				, LISTAGG(,NVL(((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF( H' || WORK_YEAR_HALF || '_SOM_PROD_QTY_SALE_PLN, 0)) - ( H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / NULLIF( H' || WORK_YEAR_HALF || '_SOM_PROD_QTY_SALE_PLN, 0))) / NULLIF((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF(H' || WORK_YEAR_HALF || '_SOM_PROD_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_PROD_ST_O2				
				]]>
			</isEqual>	
			<isNotEqual property="CHK_SUBTOTAL" compareValue="Y">	
				<![CDATA[
				/*영업이익률 MAX*/
				, LISTAGG(', CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(', NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF / H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF * 100, 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_WF_ST_O2

				, LISTAGG(', CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_EQ_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_EQ_ST_O1
				, LISTAGG(', NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF / H' || WORK_YEAR_HALF || '_SALE_DIE_PROF * 100, 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_EQ @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_EQ_ST_O2
				, LISTAGG(', CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_DIE_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_DIE_ST_O1
				, LISTAGG(', NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF / H' || WORK_YEAR_HALF || '_SALE_DIE_PROF * 100, 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_DIE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_DIE_ST_O2
				, LISTAGG(', CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_PROD_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_PROD_ST_O1
				, LISTAGG(', NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF / H' || WORK_YEAR_HALF || '_SALE_PROD_PROF * 100, 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_PROD @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_PROD_ST_O2
				]]>
			</isNotEqual>			
		</isEqual>
		<isNotEqual property="SEARCH_TYPE" compareValue="ODD">	
				<![CDATA[
				/*영업이익률 MAX*/
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF, 0) = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF/H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(,NVL(((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF( H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0)) - ( H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / NULLIF( H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0))) / NULLIF((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_WF_ST_O2				
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_EQ_PROF, 0) = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF/H' || WORK_YEAR_HALF || '_SALE_EQ_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_EQ_ST_O1				
				, LISTAGG(,NVL(((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF( H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0)) - ( H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / NULLIF( H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0))) / NULLIF((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_EQ_ST_O2				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_DIE_PROF, 0) = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF/H' || WORK_YEAR_HALF || '_SALE_DIE_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_DIE_ST_O1				
				, LISTAGG(,NVL(((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF( H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0)) - ( H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / NULLIF( H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0))) / NULLIF((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_DIE_ST_O2				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_PROD_PROF, 0) = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF/H' || WORK_YEAR_HALF || '_SALE_PROD_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_PROD_ST_O1				
				, LISTAGG(,NVL(((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF( H' || WORK_YEAR_HALF || '_SOM_PROD_QTY_SALE_PLN, 0)) - ( H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / NULLIF( H' || WORK_YEAR_HALF || '_SOM_PROD_QTY_SALE_PLN, 0))) / NULLIF((H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / NULLIF(H' || WORK_YEAR_HALF || '_SOM_PROD_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_PROD_ST_O2				
				]]>
		</isNotEqual>				
				<![CDATA[
				/*연간 영업이익률*/
				, LISTAGG(', NVL(( H' || WORK_YEAR_HALF || '_SALES_PROF_YR_PROF / NULLIF( H' || WORK_YEAR_HALF || '_SALE_YR_PROF, 0)) * 100, 0) AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_YR', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_YR_ST_O
				, 3 AS SEQ
			FROM (
				SELECT WORK_YEAR_HALF FROM MAD_CALENDAR 
				WHERE WORK_YM >= #FROM_YM#
				AND WORK_YM <= #TO_YM#
				GROUP BY WORK_YEAR_HALF
			)	
			WHERE 'Y' = #DISPLAY_HALF#	
			UNION ALL
						SELECT LISTAGG(',(''YEAR'', ''' || WORK_YEAR || ''') AS Y' || WORK_YEAR, ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS PIVOT_STR
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CUM2_YLD_MASTER_DATA, 0) AS Y' || WORK_YEAR || '_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CUM2_YLD_MASTER_DATA
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_ODD_CUM2_YLD_MASTER_DATA, 0) AS Y' || WORK_YEAR || '_ODD_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ODD_CUM2_YLD_MASTER_DATA
				, LISTAGG(',NVL(TRIM(Y' || WORK_YEAR || '_GOOD_DIE_MASTER_DATA), '' '') AS Y' || WORK_YEAR || '_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS GOOD_DIE_MASTER_DATA
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_ODD_GOOD_DIE_MASTER_DATA, 0) AS Y' || WORK_YEAR || '_ODD_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ODD_GOOD_DIE_MASTER_DATA
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0) AS Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS WF_CONV_QTY_SALE_PLN
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0) AS Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SOM_EQ_QTY_SALE_PLN
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0) AS Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SOM_DIE_QTY_SALE_PLN
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN, 0) AS Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ORG_QTY_SALE_PLN
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN, 0) AS Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_AMT_SALE_PLN
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_ASP_SALE_PLN, 0) AS Y' || WORK_YEAR || '_ASP_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ASP_SALE_PLN
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_GRAV_SALE_PLN, 0) AS Y' || WORK_YEAR || '_SALE_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_GRAV_SALE_PLN
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_QTY_GRAV_SALE_PLN, 0) AS Y' || WORK_YEAR || '_QTY_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS QTY_GRAV_SALE_PLN
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALES_PROF_GRAV_SALE_PLN, 0) AS Y' || WORK_YEAR || '_SALES_PROF_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_GRAV_SALE_PLN
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_WF_SLS_PROF, 0) AS Y' || WORK_YEAR || '_SALE_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_WF_SLS_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CNTRB_PROF_WF_SLS_PROF, 0) AS Y' || WORK_YEAR || '_CNTRB_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_PROF_WF_SLS_PROF, 0) AS Y' || WORK_YEAR || '_CASH_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_WF_SLS_PROF				
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_PROF_WF_SLS_PROF, 0) AS Y' || WORK_YEAR || '_SALE_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF, 0) AS Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_EQ_PROF, 0) AS Y' || WORK_YEAR || '_SALE_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_EQ_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CNTRB_PROF_EQ_PROF, 0) AS Y' || WORK_YEAR || '_CNTRB_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_EQ_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_PROF_EQ_PROF, 0) AS Y' || WORK_YEAR || '_CASH_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_EQ_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_PROF_EQ_PROF, 0) AS Y' || WORK_YEAR || '_SALE_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_EQ_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF, 0) AS Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_EQ_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_DIE_PROF, 0) AS Y' || WORK_YEAR || '_SALE_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_DIE_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CNTRB_PROF_DIE_PROF, 0) AS Y' || WORK_YEAR || '_CNTRB_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_DIE_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_PROF_DIE_PROF, 0) AS Y' || WORK_YEAR || '_CASH_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_DIE_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_PROF_DIE_PROF, 0) AS Y' || WORK_YEAR || '_SALE_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_DIE_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF, 0) AS Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_DIE_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_PROD_PROF, 0) AS Y' || WORK_YEAR || '_SALE_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROD_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CNTRB_PROF_PROD_PROF, 0) AS Y' || WORK_YEAR || '_CNTRB_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_PROD_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_PROF_PROD_PROF, 0) AS Y' || WORK_YEAR || '_CASH_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_PROD_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_PROF_PROD_PROF, 0) AS Y' || WORK_YEAR || '_SALE_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_PROD_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF, 0) AS Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_PROD_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_YR_PROF, 0) AS Y' || WORK_YEAR || '_SALE_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_YR_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CNTRB_PROF_YR_PROF, 0) AS Y' || WORK_YEAR || '_CNTRB_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_YR_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_PROF_YR_PROF, 0) AS Y' || WORK_YEAR || '_CASH_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_YR_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_PROF_YR_PROF, 0) AS Y' || WORK_YEAR || '_SALE_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_YR_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALES_PROF_YR_PROF, 0) AS Y' || WORK_YEAR || '_SALES_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_YR_PROF
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_VAR_COST_WF_SLS_COST, 0) AS Y' || WORK_YEAR || '_VAR_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_WF_SLS_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_COST_WF_SLS_COST, 0) AS Y' || WORK_YEAR || '_CASH_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_WF_SLS_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COGS_COST_WF_SLS_COST, 0) AS Y' || WORK_YEAR || '_COGS_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_WF_SLS_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COO_COST_WF_SLS_COST, 0) AS Y' || WORK_YEAR || '_COO_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_WF_SLS_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_VAR_COST_EQ_COST, 0) AS Y' || WORK_YEAR || '_VAR_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_EQ_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_COST_EQ_COST, 0) AS Y' || WORK_YEAR || '_CASH_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_EQ_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COGS_COST_EQ_COST, 0) AS Y' || WORK_YEAR || '_COGS_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_EQ_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COO_COST_EQ_COST, 0) AS Y' || WORK_YEAR || '_COO_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_EQ_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_VAR_COST_DIE_COST, 0) AS Y' || WORK_YEAR || '_VAR_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_DIE_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_COST_DIE_COST, 0) AS Y' || WORK_YEAR || '_CASH_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_DIE_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COGS_COST_DIE_COST, 0) AS Y' || WORK_YEAR || '_COGS_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_DIE_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COO_COST_DIE_COST, 0) AS Y' || WORK_YEAR || '_COO_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_DIE_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_VAR_COST_PROD_COST, 0) AS Y' || WORK_YEAR || '_VAR_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_PROD_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_COST_PROD_COST, 0) AS Y' || WORK_YEAR || '_CASH_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_PROD_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COGS_COST_PROD_COST, 0) AS Y' || WORK_YEAR || '_COGS_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_PROD_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COO_COST_PROD_COST, 0) AS Y' || WORK_YEAR || '_COO_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_PROD_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_VAR_COST_YR_COST, 0) AS Y' || WORK_YEAR || '_VAR_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_YR_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_COST_YR_COST, 0) AS Y' || WORK_YEAR || '_CASH_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_YR_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COGS_COST_YR_COST, 0) AS Y' || WORK_YEAR || '_COGS_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_YR_COST
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COO_COST_YR_COST, 0) AS Y' || WORK_YEAR || '_COO_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_YR_COST
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_WF_SLS_PROF,0) = 0 THEN 0 ELSE NVL( Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF / Y' || WORK_YEAR || '_SALE_WF_SLS_PROF * 100, 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_WF
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_EQ_PROF,0) = 0 THEN 0 ELSE NVL( Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF / Y' || WORK_YEAR || '_SALE_EQ_PROF * 100, 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_EQ ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_EQ
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_DIE_PROF,0) = 0 THEN 0 ELSE NVL( Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF / Y' || WORK_YEAR || '_SALE_DIE_PROF * 100, 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_DIE ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_DIE
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_PROD_PROF,0) = 0 THEN 0 ELSE NVL( Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF / Y' || WORK_YEAR || '_SALE_PROD_PROF * 100, 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_PROD ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_PROD
				/*영업이익률(연간 영업이익 / 연간 매출액)*/
				, LISTAGG(', CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_YR_PROF,0) = 0 THEN 0 ELSE NVL( Y' || WORK_YEAR || '_SALES_PROF_YR_PROF / Y' || WORK_YEAR || '_SALE_YR_PROF * 100, 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_YR ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_YR
				
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CUM2_YLD_MASTER_DATA) AS Y' || WORK_YEAR || '_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CUM2_YLD_MASTER_DATA_ST				
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_ODD_CUM2_YLD_MASTER_DATA) AS Y' || WORK_YEAR || '_ODD_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ODD_CUM2_YLD_MASTER_DATA_ST
				, LISTAGG(',MAX(Y' || WORK_YEAR || '_GOOD_DIE_MASTER_DATA) AS Y' || WORK_YEAR || '_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS GOOD_DIE_MASTER_DATA_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_ODD_GOOD_DIE_MASTER_DATA) AS Y' || WORK_YEAR || '_ODD_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ODD_GOOD_DIE_MASTER_DATA_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN) AS Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS WF_CONV_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN) AS Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SOM_EQ_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN) AS Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SOM_DIE_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN) AS Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ORG_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN) AS Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_AMT_SALE_PLN_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_ASP_SALE_PLN) AS Y' || WORK_YEAR || '_ASP_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ASP_SALE_PLN_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_GRAV_SALE_PLN) AS Y' || WORK_YEAR || '_SALE_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_QTY_GRAV_SALE_PLN) AS Y' || WORK_YEAR || '_QTY_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS QTY_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALES_PROF_GRAV_SALE_PLN) AS Y' || WORK_YEAR || '_SALES_PROF_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_WF_SLS_PROF) AS Y' || WORK_YEAR || '_SALE_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_WF_SLS_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CNTRB_PROF_WF_SLS_PROF) AS Y' || WORK_YEAR || '_CNTRB_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CASH_PROF_WF_SLS_PROF) AS Y' || WORK_YEAR || '_CASH_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_WF_SLS_PROF_ST				
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_PROF_WF_SLS_PROF) AS Y' || WORK_YEAR || '_SALE_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF) AS Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_EQ_PROF) AS Y' || WORK_YEAR || '_SALE_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_EQ_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CNTRB_PROF_EQ_PROF) AS Y' || WORK_YEAR || '_CNTRB_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CASH_PROF_EQ_PROF) AS Y' || WORK_YEAR || '_CASH_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_PROF_EQ_PROF) AS Y' || WORK_YEAR || '_SALE_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF) AS Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_DIE_PROF) AS Y' || WORK_YEAR || '_SALE_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_DIE_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CNTRB_PROF_DIE_PROF) AS Y' || WORK_YEAR || '_CNTRB_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CASH_PROF_DIE_PROF) AS Y' || WORK_YEAR || '_CASH_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_PROF_DIE_PROF) AS Y' || WORK_YEAR || '_SALE_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF) AS Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_PROD_PROF) AS Y' || WORK_YEAR || '_SALE_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROD_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CNTRB_PROF_PROD_PROF) AS Y' || WORK_YEAR || '_CNTRB_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CASH_PROF_PROD_PROF) AS Y' || WORK_YEAR || '_CASH_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_PROF_PROD_PROF) AS Y' || WORK_YEAR || '_SALE_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF) AS Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_YR_PROF) AS Y' || WORK_YEAR || '_SALE_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_YR_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CNTRB_PROF_YR_PROF) AS Y' || WORK_YEAR || '_CNTRB_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_YR_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CASH_PROF_YR_PROF) AS Y' || WORK_YEAR || '_CASH_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_YR_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALE_PROF_YR_PROF) AS Y' || WORK_YEAR || '_SALE_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_YR_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_SALES_PROF_YR_PROF) AS Y' || WORK_YEAR || '_SALES_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_YR_PROF_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_VAR_COST_WF_SLS_COST) AS Y' || WORK_YEAR || '_VAR_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CASH_COST_WF_SLS_COST) AS Y' || WORK_YEAR || '_CASH_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_COGS_COST_WF_SLS_COST) AS Y' || WORK_YEAR || '_COGS_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_COO_COST_WF_SLS_COST) AS Y' || WORK_YEAR || '_COO_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_VAR_COST_EQ_COST) AS Y' || WORK_YEAR || '_VAR_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_EQ_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CASH_COST_EQ_COST) AS Y' || WORK_YEAR || '_CASH_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_EQ_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_COGS_COST_EQ_COST) AS Y' || WORK_YEAR || '_COGS_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_EQ_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_COO_COST_EQ_COST) AS Y' || WORK_YEAR || '_COO_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_EQ_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_VAR_COST_DIE_COST) AS Y' || WORK_YEAR || '_VAR_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_DIE_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CASH_COST_DIE_COST) AS Y' || WORK_YEAR || '_CASH_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_DIE_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_COGS_COST_DIE_COST) AS Y' || WORK_YEAR || '_COGS_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_DIE_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_COO_COST_DIE_COST) AS Y' || WORK_YEAR || '_COO_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_DIE_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_VAR_COST_PROD_COST) AS Y' || WORK_YEAR || '_VAR_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_PROD_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CASH_COST_PROD_COST) AS Y' || WORK_YEAR || '_CASH_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_PROD_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_COGS_COST_PROD_COST) AS Y' || WORK_YEAR || '_COGS_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_PROD_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_COO_COST_PROD_COST) AS Y' || WORK_YEAR || '_COO_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_PROD_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_VAR_COST_YR_COST) AS Y' || WORK_YEAR || '_VAR_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_YR_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_CASH_COST_YR_COST) AS Y' || WORK_YEAR || '_CASH_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_YR_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_COGS_COST_YR_COST) AS Y' || WORK_YEAR || '_COGS_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_YR_COST_ST
				, LISTAGG(',SUM(Y' || WORK_YEAR || '_COO_COST_YR_COST) AS Y' || WORK_YEAR || '_COO_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_YR_COST_ST
				/*영업이익률 MAX(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(',MAX(Y' || WORK_YEAR || '_COO_PROF_RATE_WF) AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_WF_ST
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(',MAX(Y' || WORK_YEAR || '_COO_PROF_RATE_EQ) AS Y' || WORK_YEAR || '_COO_PROF_RATE_EQ ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_EQ_ST				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(',MAX(Y' || WORK_YEAR || '_COO_PROF_RATE_DIE) AS Y' || WORK_YEAR || '_COO_PROF_RATE_DIE ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_DIE_ST				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(',MAX(Y' || WORK_YEAR || '_COO_PROF_RATE_PROD) AS Y' || WORK_YEAR || '_COO_PROF_RATE_PROD ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_PROD_ST				
				/*영업이익률(연간 영업이익 / 연간 매출액)*/
				, LISTAGG(',MAX(Y' || WORK_YEAR || '_COO_PROF_RATE_YR) AS Y' || WORK_YEAR || '_COO_PROF_RATE_YR ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_YR_ST

				, LISTAGG(',Y' || WORK_YEAR || '_CUM2_YLD_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CUM2_YLD_MASTER_DATA_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_ODD_CUM2_YLD_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ODD_CUM2_YLD_MASTER_DATA_ST_O
				, LISTAGG(',CASE WHEN Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN = 0 THEN ''0'' ELSE CASE WHEN GRP_ID > 0 THEN TO_CHAR(Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN / Y' || WORK_YEAR || '_GOOD_DIE_MASTER_DATA END END AS Y' || WORK_YEAR || '_GOOD_DIE_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS GOOD_DIE_MASTER_DATA_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_ODD_GOOD_DIE_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ODD_GOOD_DIE_MASTER_DATA_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS WF_CONV_QTY_SALE_PLN_ST_O				
				, LISTAGG(',Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SOM_EQ_QTY_SALE_PLN_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SOM_DIE_QTY_SALE_PLN_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ORG_QTY_SALE_PLN_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_AMT_SALE_PLN_ST_O
				, LISTAGG(',CASE WHEN Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0) END AS Y' || WORK_YEAR || '_ASP_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS ASP_SALE_PLN_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_SALE_GRAV_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_GRAV_SALE_PLN_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_QTY_GRAV_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS QTY_GRAV_SALE_PLN_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_SALES_PROF_GRAV', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_GRAV_ST_O
				, LISTAGG(',CASE WHEN Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0) END AS Y' || WORK_YEAR || '_SALE_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_WF_SLS_PROF_ST_O
				, LISTAGG(',CASE WHEN Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0) END AS Y' || WORK_YEAR || '_SALE_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0) END AS Y' || WORK_YEAR || '_SALE_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_DIE_PROF_ST_O
				, LISTAGG(',CASE WHEN Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN, 0) END AS Y' || WORK_YEAR || '_SALE_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROD_PROF_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_SALE_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_YR_PROF_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_CNTRB_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_YR_PROF_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_CASH_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_YR_PROF_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_SALE_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_YR_PROF_ST_O
				, LISTAGG(',Y' || WORK_YEAR || '_SALES_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_YR_PROF_ST_O
			]]>
	<isEqual property="SEARCH_TYPE" compareValue="ODD">
		<isEqual property="CHK_SUBTOTAL" compareValue="Y">		
			<![CDATA[
				/*장당 원가*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN Y' || WORK_YEAR || '_VAR_COST_WF_SLS_COST ELSE CASE WHEN NVL(Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE Y' || WORK_YEAR || '_VAR_COST_YR_COST / Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_VAR_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_WF_SLS_COST_ST_O
