				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE Y' || WORK_YEAR || '_COGS_COST_YR_COST / Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_COGS_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_WF_SLS_COST_ST_O
