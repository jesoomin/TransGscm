				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(M' || WORK_YM || '_CASH_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (M' || WORK_YM || '_SALE_AMT_SALE_PLN - M' || WORK_YM || '_CASH_COST_YR_COST) / M' || WORK_YM || '_ORG_QTY_SALE_PLN END END AS M' || WORK_YM || '_CASH_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_PROD_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(M' || WORK_YM || '_SALE_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (M' || WORK_YM || '_SALE_AMT_SALE_PLN - M' || WORK_YM || '_COGS_COST_YR_COST) / M' || WORK_YM || '_ORG_QTY_SALE_PLN END END AS M' || WORK_YM || '_SALE_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_PROD_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(M' || WORK_YM || '_SALES_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (M' || WORK_YM || '_SALE_AMT_SALE_PLN - M' || WORK_YM || '_COO_COST_YR_COST) / M' || WORK_YM || '_ORG_QTY_SALE_PLN END END AS M' || WORK_YM || '_SALES_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_PROD_PROF_ST_O
			]]>
		</isNotEqual>
			<![CDATA[				
				, LISTAGG(',NVL(M' || WORK_YM || '_VAR_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_YR_COST_ST_O
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_YR_COST_ST_O
				, LISTAGG(',NVL(M' || WORK_YM || '_COGS_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_YR_COST_ST_O
				, LISTAGG(',NVL(M' || WORK_YM || '_COO_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_YR_COST_ST_O
			]]>
		<isEqual property="SEARCH_TYPE" compareValue="ODD">
			<isEqual property="CHK_SUBTOTAL" compareValue="Y">	
				<![CDATA[
				/*영업이익률 MAX*/
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(M' || WORK_YM || '_SALE_WF_SLS_PROF,0) = 0 THEN 0 ELSE NVL( M' || WORK_YM || '_SALES_PROF_WF_SLS_PROF / M' || WORK_YM || '_SALE_WF_SLS_PROF * 100, 0) END ELSE CASE WHEN NVL( M' || WORK_YM || '_SALE_WF_SLS_PROF, 0) = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALES_PROF_WF_SLS_PROF/ M' || WORK_YM || '_SALE_WF_SLS_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(,NVL(((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF( M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0)) - ( M' || WORK_YM || '_COO_COST_YR_COST / NULLIF( M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0))) / NULLIF((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF(M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS M' || WORK_YM || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_WF_ST_O2				
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(M' || WORK_YM || '_SALE_EQ_PROF,0) = 0 THEN 0 ELSE NVL( M' || WORK_YM || '_SALES_PROF_EQ_PROF / M' || WORK_YM || '_SALE_EQ_PROF * 100, 0) END ELSE CASE WHEN NVL( M' || WORK_YM || '_SALE_EQ_PROF, 0) = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALES_PROF_EQ_PROF/ M' || WORK_YM || '_SALE_EQ_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_EQ_ST_O1
				, LISTAGG(,NVL(((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF( M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0)) - ( M' || WORK_YM || '_COO_COST_YR_COST / NULLIF( M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0))) / NULLIF((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS M' || WORK_YM || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_EQ_ST_O2				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(M' || WORK_YM || '_SALE_DIE_PROF,0) = 0 THEN 0 ELSE NVL( M' || WORK_YM || '_SALES_PROF_DIE_PROF / M' || WORK_YM || '_SALE_DIE_PROF * 100, 0) END ELSE CASE WHEN NVL( M' || WORK_YM || '_SALE_DIE_PROF, 0) = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALES_PROF_DIE_PROF/ M' || WORK_YM || '_SALE_DIE_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_DIE_ST_O1
				, LISTAGG(,NVL(((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF( M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0)) - ( M' || WORK_YM || '_COO_COST_YR_COST / NULLIF( M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0))) / NULLIF((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS M' || WORK_YM || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_DIE_ST_O2				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(M' || WORK_YM || '_SALE_PROD_PROF,0) = 0 THEN 0 ELSE NVL( M' || WORK_YM || '_SALES_PROF_PROD_PROF / M' || WORK_YM || '_SALE_PROD_PROF * 100, 0) END ELSE CASE WHEN NVL( M' || WORK_YM || '_SALE_PROD_PROF, 0) = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALES_PROF_PROD_PROF/ M' || WORK_YM || '_SALE_PROD_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_PROD_ST_O1
				, LISTAGG(,NVL(((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF( M' || WORK_YM || '_SOM_PROD_QTY_SALE_PLN, 0)) - ( M' || WORK_YM || '_COO_COST_YR_COST / NULLIF( M' || WORK_YM || '_SOM_PROD_QTY_SALE_PLN, 0))) / NULLIF((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF(M' || WORK_YM || '_SOM_PROD_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS M' || WORK_YM || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_PROD_ST_O2				
				]]>
			</isEqual>	
			<isNotEqual property="CHK_SUBTOTAL" compareValue="Y">	
				<![CDATA[
				/*영업이익률 MAX*/
				, LISTAGG(', CASE WHEN NVL(M' || WORK_YM || '_SALE_WF_SLS_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(', NVL(M' || WORK_YM || '_SALES_PROF_WF_SLS_PROF / M' || WORK_YM || '_SALE_WF_SLS_PROF * 100, 0) END AS M' || WORK_YM || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_WF_ST_O2

				, LISTAGG(', CASE WHEN NVL(M' || WORK_YM || '_SALE_EQ_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_EQ_ST_O1
				, LISTAGG(', NVL(M' || WORK_YM || '_SALES_PROF_EQ_PROF / M' || WORK_YM || '_SALE_DIE_PROF * 100, 0) END AS M' || WORK_YM || '_COO_PROF_RATE_EQ @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_EQ_ST_O2
				, LISTAGG(', CASE WHEN NVL(M' || WORK_YM || '_SALE_DIE_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_DIE_ST_O1
				, LISTAGG(', NVL(M' || WORK_YM || '_SALES_PROF_DIE_PROF / M' || WORK_YM || '_SALE_DIE_PROF * 100, 0) END AS M' || WORK_YM || '_COO_PROF_RATE_DIE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_DIE_ST_O2
