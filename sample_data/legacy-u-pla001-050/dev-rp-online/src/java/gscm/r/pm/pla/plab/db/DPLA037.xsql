												UPPER_CD1
										]]>
									</isEqual><![CDATA[																				
											)
											, MQHYT											
										)
									) B
									WHERE A.MQHYT = B.MQHYT
									AND A.GRP_ID = B.GRP_ID
									]]>
									<isEqual property="SRCTYPE" compareValue="BASE">
										$GROUPING_WHERE$
									</isEqual>
