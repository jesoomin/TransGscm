				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF, 0) AS Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_EQ_PROF_ST_O
