			, LISTAGG(COO_COST_DIE_COST_ST_O, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_COST_DIE_COST_ST_O
			, LISTAGG(VAR_COST_PROD_COST_ST_O, ' ') WITHIN GROUP (ORDER BY SEQ) AS VAR_COST_PROD_COST_ST_O
			, LISTAGG(CASH_COST_PROD_COST_ST_O, ' ') WITHIN GROUP (ORDER BY SEQ) AS CASH_COST_PROD_COST_ST_O
			, LISTAGG(COGS_COST_PROD_COST_ST_O, ' ') WITHIN GROUP (ORDER BY SEQ) AS COGS_COST_PROD_COST_ST_O
			, LISTAGG(COO_COST_PROD_COST_ST_O, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_COST_PROD_COST_ST_O
			, LISTAGG(VAR_COST_YR_COST_ST_O, ' ') WITHIN GROUP (ORDER BY SEQ) AS VAR_COST_YR_COST_ST_O
			, LISTAGG(CASH_COST_YR_COST_ST_O, ' ') WITHIN GROUP (ORDER BY SEQ) AS CASH_COST_YR_COST_ST_O
			, LISTAGG(COGS_COST_YR_COST_ST_O, ' ') WITHIN GROUP (ORDER BY SEQ) AS COGS_COST_YR_COST_ST_O
			, LISTAGG(COO_COST_YR_COST_ST_O, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_COST_YR_COST_ST_O
			, LISTAGG(COO_PROF_RATE_WF_ST_O1, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_PROF_RATE_WF_ST_O1
			, LISTAGG(COO_PROF_RATE_WF_ST_O2, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_PROF_RATE_WF_ST_O2
			, LISTAGG(COO_PROF_RATE_EQ_ST_O1, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_PROF_RATE_EQ_ST_O1
			, LISTAGG(COO_PROF_RATE_EQ_ST_O2, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_PROF_RATE_EQ_ST_O2
			, LISTAGG(COO_PROF_RATE_DIE_ST_O1, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_PROF_RATE_DIE_ST_O1
			, LISTAGG(COO_PROF_RATE_DIE_ST_O2, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_PROF_RATE_DIE_ST_O2
			, LISTAGG(COO_PROF_RATE_PROD_ST_O1, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_PROF_RATE_PROD_ST_O1
			, LISTAGG(COO_PROF_RATE_PROD_ST_O2, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_PROF_RATE_PROD_ST_O2
			, LISTAGG(COO_PROF_RATE_YR_ST_O, ' ') WITHIN GROUP (ORDER BY SEQ) AS COO_PROF_RATE_YR_ST_O
		FROM (
			SELECT LISTAGG(',(''MONTH'', ''' || WORK_YM || ''') AS M' || WORK_YM, ' ') WITHIN GROUP (ORDER BY WORK_YM) AS PIVOT_STR
				, LISTAGG(',NVL(M' || WORK_YM || '_CUM2_YLD_MASTER_DATA, 0) AS M' || WORK_YM || '_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CUM2_YLD_MASTER_DATA
				, LISTAGG(',NVL(M' || WORK_YM || '_ODD_CUM2_YLD_MASTER_DATA, 0) AS M' || WORK_YM || '_ODD_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ODD_CUM2_YLD_MASTER_DATA
				, LISTAGG(',NVL(TRIM(M' || WORK_YM || '_GOOD_DIE_MASTER_DATA), '' '') AS M' || WORK_YM || '_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS GOOD_DIE_MASTER_DATA
				, LISTAGG(',NVL(M' || WORK_YM || '_ODD_GOOD_DIE_MASTER_DATA, 0) AS M' || WORK_YM || '_ODD_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ODD_GOOD_DIE_MASTER_DATA
				, LISTAGG(',NVL(M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0) AS M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS WF_CONV_QTY_SALE_PLN
				, LISTAGG(',NVL(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0) AS M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SOM_EQ_QTY_SALE_PLN
				, LISTAGG(',NVL(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0) AS M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SOM_DIE_QTY_SALE_PLN
				, LISTAGG(',NVL(M' || WORK_YM || '_ORG_QTY_SALE_PLN, 0) AS M' || WORK_YM || '_ORG_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ORG_QTY_SALE_PLN
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_AMT_SALE_PLN, 0) AS M' || WORK_YM || '_SALE_AMT_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_AMT_SALE_PLN
				, LISTAGG(',NVL(M' || WORK_YM || '_ASP_SALE_PLN, 0) AS M' || WORK_YM || '_ASP_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ASP_SALE_PLN
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_GRAV_SALE_PLN, 0) AS M' || WORK_YM || '_SALE_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_GRAV_SALE_PLN
				, LISTAGG(',NVL(M' || WORK_YM || '_QTY_GRAV_SALE_PLN, 0) AS M' || WORK_YM || '_QTY_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS QTY_GRAV_SALE_PLN
				, LISTAGG(',NVL(M' || WORK_YM || '_SALES_PROF_GRAV_SALE_PLN, 0) AS M' || WORK_YM || '_SALES_PROF_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_GRAV_SALE_PLN
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_WF_SLS_PROF, 0) AS M' || WORK_YM || '_SALE_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_WF_SLS_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_CNTRB_PROF_WF_SLS_PROF, 0) AS M' || WORK_YM || '_CNTRB_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_PROF_WF_SLS_PROF, 0) AS M' || WORK_YM || '_CASH_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_WF_SLS_PROF				
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_PROF_WF_SLS_PROF, 0) AS M' || WORK_YM || '_SALE_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALES_PROF_WF_SLS_PROF, 0) AS M' || WORK_YM || '_SALES_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_EQ_PROF, 0) AS M' || WORK_YM || '_SALE_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_EQ_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_CNTRB_PROF_EQ_PROF, 0) AS M' || WORK_YM || '_CNTRB_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_EQ_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_PROF_EQ_PROF, 0) AS M' || WORK_YM || '_CASH_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_EQ_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_PROF_EQ_PROF, 0) AS M' || WORK_YM || '_SALE_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_EQ_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALES_PROF_EQ_PROF, 0) AS M' || WORK_YM || '_SALES_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_EQ_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_DIE_PROF, 0) AS M' || WORK_YM || '_SALE_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_DIE_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_CNTRB_PROF_DIE_PROF, 0) AS M' || WORK_YM || '_CNTRB_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_DIE_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_PROF_DIE_PROF, 0) AS M' || WORK_YM || '_CASH_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_DIE_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_PROF_DIE_PROF, 0) AS M' || WORK_YM || '_SALE_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_DIE_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALES_PROF_DIE_PROF, 0) AS M' || WORK_YM || '_SALES_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_DIE_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_PROD_PROF, 0) AS M' || WORK_YM || '_SALE_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROD_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_CNTRB_PROF_PROD_PROF, 0) AS M' || WORK_YM || '_CNTRB_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_PROD_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_PROF_PROD_PROF, 0) AS M' || WORK_YM || '_CASH_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_PROD_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_PROF_PROD_PROF, 0) AS M' || WORK_YM || '_SALE_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_PROD_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALES_PROF_PROD_PROF, 0) AS M' || WORK_YM || '_SALES_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_PROD_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_YR_PROF, 0) AS M' || WORK_YM || '_SALE_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_YR_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_CNTRB_PROF_YR_PROF, 0) AS M' || WORK_YM || '_CNTRB_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_YR_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_PROF_YR_PROF, 0) AS M' || WORK_YM || '_CASH_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_YR_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALE_PROF_YR_PROF, 0) AS M' || WORK_YM || '_SALE_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_YR_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_SALES_PROF_YR_PROF, 0) AS M' || WORK_YM || '_SALES_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_YR_PROF
				, LISTAGG(',NVL(M' || WORK_YM || '_VAR_COST_WF_SLS_COST, 0) AS M' || WORK_YM || '_VAR_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_WF_SLS_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_COST_WF_SLS_COST, 0) AS M' || WORK_YM || '_CASH_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_WF_SLS_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_COGS_COST_WF_SLS_COST, 0) AS M' || WORK_YM || '_COGS_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_WF_SLS_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_COO_COST_WF_SLS_COST, 0) AS M' || WORK_YM || '_COO_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_WF_SLS_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_VAR_COST_EQ_COST, 0) AS M' || WORK_YM || '_VAR_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_EQ_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_COST_EQ_COST, 0) AS M' || WORK_YM || '_CASH_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_EQ_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_COGS_COST_EQ_COST, 0) AS M' || WORK_YM || '_COGS_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_EQ_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_COO_COST_EQ_COST, 0) AS M' || WORK_YM || '_COO_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_EQ_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_VAR_COST_DIE_COST, 0) AS M' || WORK_YM || '_VAR_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_DIE_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_COST_DIE_COST, 0) AS M' || WORK_YM || '_CASH_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_DIE_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_COGS_COST_DIE_COST, 0) AS M' || WORK_YM || '_COGS_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_DIE_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_COO_COST_DIE_COST, 0) AS M' || WORK_YM || '_COO_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_DIE_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_VAR_COST_PROD_COST, 0) AS M' || WORK_YM || '_VAR_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_PROD_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_COST_PROD_COST, 0) AS M' || WORK_YM || '_CASH_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_PROD_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_COGS_COST_PROD_COST, 0) AS M' || WORK_YM || '_COGS_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_PROD_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_COO_COST_PROD_COST, 0) AS M' || WORK_YM || '_COO_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_PROD_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_VAR_COST_YR_COST, 0) AS M' || WORK_YM || '_VAR_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_YR_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_CASH_COST_YR_COST, 0) AS M' || WORK_YM || '_CASH_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_YR_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_COGS_COST_YR_COST, 0) AS M' || WORK_YM || '_COGS_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_YR_COST
				, LISTAGG(',NVL(M' || WORK_YM || '_COO_COST_YR_COST, 0) AS M' || WORK_YM || '_COO_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_YR_COST
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN NVL(M' || WORK_YM || '_SALE_WF_SLS_PROF,0) = 0 THEN 0 ELSE NVL( M' || WORK_YM || '_SALES_PROF_WF_SLS_PROF / M' || WORK_YM || '_SALE_WF_SLS_PROF * 100, 0) END AS M' || WORK_YM || '_COO_PROF_RATE_WF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_WF
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN NVL(M' || WORK_YM || '_SALE_EQ_PROF,0) = 0 THEN 0 ELSE NVL( M' || WORK_YM || '_SALES_PROF_EQ_PROF / M' || WORK_YM || '_SALE_EQ_PROF * 100, 0) END AS M' || WORK_YM || '_COO_PROF_RATE_EQ ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_EQ
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN NVL(M' || WORK_YM || '_SALE_DIE_PROF,0) = 0 THEN 0 ELSE NVL( M' || WORK_YM || '_SALES_PROF_DIE_PROF / M' || WORK_YM || '_SALE_DIE_PROF * 100, 0) END AS M' || WORK_YM || '_COO_PROF_RATE_DIE ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_DIE
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN NVL(M' || WORK_YM || '_SALE_PROD_PROF,0) = 0 THEN 0 ELSE NVL( M' || WORK_YM || '_SALES_PROF_PROD_PROF / M' || WORK_YM || '_SALE_PROD_PROF * 100, 0) END AS M' || WORK_YM || '_COO_PROF_RATE_PROD ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_PROD
				/*영업이익률(연간 영업이익 / 연간 매출액)*/
				, LISTAGG(', CASE WHEN NVL(M' || WORK_YM || '_SALE_YR_PROF,0) = 0 THEN 0 ELSE NVL( M' || WORK_YM || '_SALES_PROF_YR_PROF / M' || WORK_YM || '_SALE_YR_PROF * 100, 0) END AS M' || WORK_YM || '_COO_PROF_RATE_YR ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_YR
				
				, LISTAGG(',SUM(M' || WORK_YM || '_CUM2_YLD_MASTER_DATA) AS M' || WORK_YM || '_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CUM2_YLD_MASTER_DATA_ST				
				, LISTAGG(',SUM(M' || WORK_YM || '_ODD_CUM2_YLD_MASTER_DATA) AS M' || WORK_YM || '_ODD_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ODD_CUM2_YLD_MASTER_DATA_ST
				, LISTAGG(',SUM(TRIM(M' || WORK_YM || '_GOOD_DIE_MASTER_DATA), '' '') AS M' || WORK_YM || '_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS GOOD_DIE_MASTER_DATA_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_ODD_GOOD_DIE_MASTER_DATA) AS M' || WORK_YM || '_ODD_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ODD_GOOD_DIE_MASTER_DATA_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN) AS M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS WF_CONV_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN) AS M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SOM_EQ_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN) AS M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SOM_DIE_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_ORG_QTY_SALE_PLN) AS M' || WORK_YM || '_ORG_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ORG_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_AMT_SALE_PLN) AS M' || WORK_YM || '_SALE_AMT_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_AMT_SALE_PLN_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_ASP_SALE_PLN) AS M' || WORK_YM || '_ASP_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ASP_SALE_PLN_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_GRAV_SALE_PLN) AS M' || WORK_YM || '_SALE_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_QTY_GRAV_SALE_PLN) AS M' || WORK_YM || '_QTY_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS QTY_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALES_PROF_GRAV_SALE_PLN) AS M' || WORK_YM || '_SALES_PROF_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_WF_SLS_PROF) AS M' || WORK_YM || '_SALE_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_WF_SLS_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CNTRB_PROF_WF_SLS_PROF) AS M' || WORK_YM || '_CNTRB_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CASH_PROF_WF_SLS_PROF) AS M' || WORK_YM || '_CASH_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_WF_SLS_PROF_ST				
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_PROF_WF_SLS_PROF) AS M' || WORK_YM || '_SALE_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALES_PROF_WF_SLS_PROF) AS M' || WORK_YM || '_SALES_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_EQ_PROF) AS M' || WORK_YM || '_SALE_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_EQ_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CNTRB_PROF_EQ_PROF) AS M' || WORK_YM || '_CNTRB_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CASH_PROF_EQ_PROF) AS M' || WORK_YM || '_CASH_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_PROF_EQ_PROF) AS M' || WORK_YM || '_SALE_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALES_PROF_EQ_PROF) AS M' || WORK_YM || '_SALES_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_DIE_PROF) AS M' || WORK_YM || '_SALE_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_DIE_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CNTRB_PROF_DIE_PROF) AS M' || WORK_YM || '_CNTRB_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CASH_PROF_DIE_PROF) AS M' || WORK_YM || '_CASH_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_PROF_DIE_PROF) AS M' || WORK_YM || '_SALE_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALES_PROF_DIE_PROF) AS M' || WORK_YM || '_SALES_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_PROD_PROF) AS M' || WORK_YM || '_SALE_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROD_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CNTRB_PROF_PROD_PROF) AS M' || WORK_YM || '_CNTRB_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CASH_PROF_PROD_PROF) AS M' || WORK_YM || '_CASH_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_PROF_PROD_PROF) AS M' || WORK_YM || '_SALE_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALES_PROF_PROD_PROF) AS M' || WORK_YM || '_SALES_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_YR_PROF) AS M' || WORK_YM || '_SALE_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_YR_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CNTRB_PROF_YR_PROF) AS M' || WORK_YM || '_CNTRB_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_YR_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CASH_PROF_YR_PROF) AS M' || WORK_YM || '_CASH_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_YR_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALE_PROF_YR_PROF) AS M' || WORK_YM || '_SALE_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_YR_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_SALES_PROF_YR_PROF) AS M' || WORK_YM || '_SALES_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_YR_PROF_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_VAR_COST_WF_SLS_COST) AS M' || WORK_YM || '_VAR_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CASH_COST_WF_SLS_COST) AS M' || WORK_YM || '_CASH_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_COGS_COST_WF_SLS_COST) AS M' || WORK_YM || '_COGS_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_COO_COST_WF_SLS_COST) AS M' || WORK_YM || '_COO_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_VAR_COST_EQ_COST) AS M' || WORK_YM || '_VAR_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_EQ_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CASH_COST_EQ_COST) AS M' || WORK_YM || '_CASH_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_EQ_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_COGS_COST_EQ_COST) AS M' || WORK_YM || '_COGS_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_EQ_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_COO_COST_EQ_COST) AS M' || WORK_YM || '_COO_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_EQ_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_VAR_COST_DIE_COST) AS M' || WORK_YM || '_VAR_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_DIE_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CASH_COST_DIE_COST) AS M' || WORK_YM || '_CASH_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_DIE_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_COGS_COST_DIE_COST) AS M' || WORK_YM || '_COGS_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_DIE_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_COO_COST_DIE_COST) AS M' || WORK_YM || '_COO_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_DIE_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_VAR_COST_PROD_COST) AS M' || WORK_YM || '_VAR_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_PROD_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CASH_COST_PROD_COST) AS M' || WORK_YM || '_CASH_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_PROD_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_COGS_COST_PROD_COST) AS M' || WORK_YM || '_COGS_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_PROD_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_COO_COST_PROD_COST) AS M' || WORK_YM || '_COO_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_PROD_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_VAR_COST_YR_COST) AS M' || WORK_YM || '_VAR_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_YR_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_CASH_COST_YR_COST) AS M' || WORK_YM || '_CASH_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_YR_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_COGS_COST_YR_COST) AS M' || WORK_YM || '_COGS_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_YR_COST_ST
				, LISTAGG(',SUM(M' || WORK_YM || '_COO_COST_YR_COST) AS M' || WORK_YM || '_COO_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_YR_COST_ST
				/*영업이익률 MAX(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(',MAX(M' || WORK_YM || '_COO_PROF_RATE_WF) AS M' || WORK_YM || '_COO_PROF_RATE_WF ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_WF_ST
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(',MAX(M' || WORK_YM || '_COO_PROF_RATE_EQ) AS M' || WORK_YM || '_COO_PROF_RATE_EQ ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_EQ_ST				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(',MAX(M' || WORK_YM || '_COO_PROF_RATE_DIE) AS M' || WORK_YM || '_COO_PROF_RATE_DIE ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_DIE_ST				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(',MAX(M' || WORK_YM || '_COO_PROF_RATE_PROD) AS M' || WORK_YM || '_COO_PROF_RATE_PROD ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_PROD_ST				
				/*영업이익률(연간 영업이익 / 연간 매출액)*/
				, LISTAGG(',MAX(M' || WORK_YM || '_COO_PROF_RATE_YR) AS M' || WORK_YM || '_COO_PROF_RATE_YR ', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_YR_ST

				, LISTAGG(',M' || WORK_YM || '_CUM2_YLD_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CUM2_YLD_MASTER_DATA_ST_O
				, LISTAGG(',M' || WORK_YM || '_ODD_CUM2_YLD_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ODD_CUM2_YLD_MASTER_DATA_ST_O
				, LISTAGG(',CASE WHEN M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN = 0 THEN ''0'' ELSE CASE WHEN GRP_ID > 0 THEN TO_CHAR(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN / M' || WORK_YM || '_GOOD_DIE_MASTER_DATA END END AS M' || WORK_YM || '_GOOD_DIE_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS GOOD_DIE_MASTER_DATA_ST_O
				, LISTAGG(',M' || WORK_YM || '_ODD_GOOD_DIE_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ODD_GOOD_DIE_MASTER_DATA_ST_O
				, LISTAGG(',M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS WF_CONV_QTY_SALE_PLN_ST_O				
				, LISTAGG(',M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SOM_EQ_QTY_SALE_PLN_ST_O
				, LISTAGG(',M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SOM_DIE_QTY_SALE_PLN_ST_O
				, LISTAGG(',M' || WORK_YM || '_ORG_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ORG_QTY_SALE_PLN_ST_O
				, LISTAGG(',M' || WORK_YM || '_SALE_AMT_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_AMT_SALE_PLN_ST_O
				, LISTAGG(',CASE WHEN M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALE_AMT_SALE_PLN / M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0) END AS M' || WORK_YM || '_ASP_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS ASP_SALE_PLN_ST_O
				, LISTAGG(',M' || WORK_YM || '_SALE_GRAV_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_GRAV_SALE_PLN_ST_O
				, LISTAGG(',M' || WORK_YM || '_QTY_GRAV_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS QTY_GRAV_SALE_PLN_ST_O
				, LISTAGG(',M' || WORK_YM || '_SALES_PROF_GRAV', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_GRAV_ST_O
				, LISTAGG(',CASE WHEN M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALE_AMT_SALE_PLN / M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0) END AS M' || WORK_YM || '_SALE_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_WF_SLS_PROF_ST_O
				, LISTAGG(',CASE WHEN M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALE_AMT_SALE_PLN / M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0) END AS M' || WORK_YM || '_SALE_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALE_AMT_SALE_PLN / M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0) END AS M' || WORK_YM || '_SALE_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_DIE_PROF_ST_O
				, LISTAGG(',CASE WHEN M' || WORK_YM || '_ORG_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALE_AMT_SALE_PLN / M' || WORK_YM || '_ORG_QTY_SALE_PLN, 0) END AS M' || WORK_YM || '_SALE_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROD_PROF_ST_O
				, LISTAGG(',M' || WORK_YM || '_SALE_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_YR_PROF_ST_O
				, LISTAGG(',M' || WORK_YM || '_CNTRB_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CNTRB_PROF_YR_PROF_ST_O
				, LISTAGG(',M' || WORK_YM || '_CASH_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_YR_PROF_ST_O
				, LISTAGG(',M' || WORK_YM || '_SALE_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALE_PROF_YR_PROF_ST_O
				, LISTAGG(',M' || WORK_YM || '_SALES_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS SALES_PROF_YR_PROF_ST_O
			]]>
	<isEqual property="SEARCH_TYPE" compareValue="ODD">
		<isEqual property="CHK_SUBTOTAL" compareValue="Y">		
			<![CDATA[
				/*장당 원가*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_VAR_COST_WF_SLS_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_VAR_COST_YR_COST / M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN END END AS M' || WORK_YM || '_VAR_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_WF_SLS_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_CASH_COST_WF_SLS_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_CASH_COST_YR_COST / M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN END END AS M' || WORK_YM || '_CASH_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_WF_SLS_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_COGS_COST_WF_SLS_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_COGS_COST_YR_COST / M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN END END AS M' || WORK_YM || '_COGS_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_WF_SLS_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_COO_COST_WF_SLS_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_COO_COST_YR_COST / M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN END END AS M' || WORK_YM || '_COO_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_WF_SLS_COST_ST_O
				/*EQ 원가*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_VAR_COST_EQ_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_VAR_COST_YR_COST / M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN END END AS M' || WORK_YM || '_VAR_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_EQ_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_CASH_COST_EQ_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_CASH_COST_YR_COST / M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN END END AS M' || WORK_YM || '_CASH_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_EQ_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_COGS_COST_EQ_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_COGS_COST_YR_COST / M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN END END AS M' || WORK_YM || '_COGS_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_EQ_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_COO_COST_EQ_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_COO_COST_YR_COST / M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN END END AS M' || WORK_YM || '_COO_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_EQ_COST_ST_O
				/*DIE 원가*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_VAR_COST_DIE_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_VAR_COST_YR_COST / M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN END END AS M' || WORK_YM || '_VAR_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_DIE_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_CASH_COST_DIE_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_CASH_COST_YR_COST / M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN END END AS M' || WORK_YM || '_CASH_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_COST_DIE_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_COGS_COST_DIE_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_COGS_COST_YR_COST / M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN END END AS M' || WORK_YM || '_COGS_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COGS_COST_DIE_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_COO_COST_DIE_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_COO_COST_YR_COST / M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN END END AS M' || WORK_YM || '_COO_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_COST_DIE_COST_ST_O
				/*제품 원가*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN M' || WORK_YM || '_VAR_COST_PROD_COST ELSE CASE WHEN NVL(M' || WORK_YM || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE M' || WORK_YM || '_VAR_COST_YR_COST / M' || WORK_YM || '_ORG_QTY_SALE_PLN END END AS M' || WORK_YM || '_VAR_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS VAR_COST_PROD_COST_ST_O
