						 $COO_COST_DIE_COST_ST_O$ 
					]]></isEqual>
				</isNotEqual>
				<isEqual property="VAR_COST_PROD_COST_YN" compareValue="Y"><![CDATA[
					 $VAR_COST_PROD_COST_ST_O$ 
				]]></isEqual>
				<isEqual property="CASH_COST_PROD_COST_YN" compareValue="Y"><![CDATA[
					 $CASH_COST_PROD_COST_ST_O$ 
				]]></isEqual>
				<isEqual property="COGS_COST_PROD_COST_YN" compareValue="Y"><![CDATA[
					 $COGS_COST_PROD_COST_ST_O$ 
				]]></isEqual>
				<isNotEqual property="CHKDASHBOARDYN" compareValue="Y">	
					<isEqual property="COO_COST_PROD_COST_YN" compareValue="Y"><![CDATA[
						 $COO_COST_PROD_COST_ST_O$ 
					]]></isEqual>
				</isNotEqual>
				<isEqual property="VAR_COST_YR_COST_YN" compareValue="Y"><![CDATA[
					 $VAR_COST_YR_COST$ 
				]]></isEqual>
				<isEqual property="CASH_COST_YR_COST_YN" compareValue="Y"><![CDATA[
					 $CASH_COST_YR_COST$ 
				]]></isEqual>
				<isEqual property="COGS_COST_YR_COST_YN" compareValue="Y"><![CDATA[
					 $COGS_COST_YR_COST$ 
				]]></isEqual>
				<isNotEqual property="CHKDASHBOARDYN" compareValue="Y">	
					<isEqual property="COO_COST_YR_COST_YN" compareValue="Y"><![CDATA[
						 $COO_COST_YR_COST$ 
					]]></isEqual>
				</isNotEqual>
				<isEqual property="CHKDASHBOARDYN" compareValue="Y">
					<![CDATA[
					 $SOM_EQ_QTY_SALE_PLN$ 
					 $ASP_SALE_PLN$
					]]>
					<isEqual property="GRAVYN" compareValue="Y">
						<![CDATA[
						$SALE_GRAV_SALE_PLN$ 
						$QTY_GRAV_SALE_PLN$
						$SALES_PROF_GRAV$
						]]>
					</isEqual>	
				</isEqual>
				<![CDATA[
					, TO_NUMBER(MONTHS_BETWEEN(TO_DATE(#TO_YM#, 'YYYYMM'), TO_DATE(#FROM_YM#, 'YYYYMM'))) + 1 AS MONTH_BETWEEN
					, #FROM_YM# AS START_MONTH
					, #TO_YM# AS END_MONTH
					, (SELECT MIN(WORK_YEAR_QUTR)
						FROM (
							SELECT WORK_YEAR_QUTR
									, WORK_YEAR_HALF
									, WORK_YEAR
								FROM MAD_CALENDAR
								WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
							)
						) AS START_QUARTER
					, (SELECT MIN(WORK_YEAR_HALF)
						FROM (
							SELECT WORK_YEAR_QUTR
									, WORK_YEAR_HALF
									, WORK_YEAR
								FROM MAD_CALENDAR
								WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
							)
						) AS START_HALF
					, (SELECT MIN(WORK_YEAR)
						FROM (
							SELECT WORK_YEAR_QUTR
									, WORK_YEAR_HALF
									, WORK_YEAR
								FROM MAD_CALENDAR
								WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
							)
						) AS START_YEAR	
					, (
						SELECT COUNT(*)
							FROM (
									SELECT DISTINCT WORK_YM
									FROM MAD_CALENDAR
									WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
									AND 'Y' = #DISPLAY_MONTH#
								UNION ALL
									SELECT DISTINCT WORK_YEAR_QUTR
									FROM MAD_CALENDAR
									WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
									AND 'Y' = #DISPLAY_QUARTER#
								UNION ALL
									SELECT DISTINCT WORK_YEAR_HALF
									FROM MAD_CALENDAR
									WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
									AND 'Y' = #DISPLAY_HALF#
								UNION ALL
									SELECT DISTINCT WORK_YEAR
									FROM MAD_CALENDAR
									WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
									AND 'Y' = #DISPLAY_YEAR#		
								)
					) AS COLUMN_COUNT
					, (
						SELECT START_GUBUN
							FROM (
								SELECT START_GUBUN
									FROM (
										SELECT 'YM' AS START_GUBUN
												, 1 AS SEQ
												FROM DUAL
												WHERE 'Y' = #DISPLAY_MONTH#
									UNION ALL
										SELECT 'QUARTER' AS START_GUBUN
												, 2 AS SEQ
												FROM DUAL
												WHERE 'Y' = #DISPLAY_QUARTER#
									UNION ALL
										SELECT 'HALF' AS START_GUBUN
												, 3 AS SEQ
												FROM DUAL
												WHERE 'Y' = #DISPLAY_HALF#
									UNION ALL
										SELECT 'YEAR' AS START_GUBUN
												, 4 AS SEQ
												FROM DUAL
												WHERE 'Y' = #DISPLAY_YEAR#										
									)
								ORDER BY SEQ	
							)
						WHERE ROWNUM <= 1	
					) AS START_GUBUN
					, #PLN_VER#	AS PLN_REV
					, (SELECT PLN_YW FROM PMI_PLN_REV WHERE PLN_REV = #PLN_VER#) AS PLN_YW	
					, 'ORG' AS DATA_GBN_CD
					, (SELECT PLN_YM FROM PMI_PLN_REV WHERE PLN_REV = #PLN_VER#) AS PLN_YM
				]]><isEqual property="SRCTYPE" compareValue="BASE">
					<![CDATA[
						 $DIM_OUTER_SEQ$ 
					]]>
				</isEqual>
					<![CDATA[
						 FROM (
					]]>
				<include refid="queryCommon" />
					<![CDATA[
						 FOR (MQHYT_GBN, MQHYT) IN ($PIVOT_STR$)
						 ) T1
						ORDER BY 
					]]>					
				<isEqual property="SRCTYPE" compareValue="BASE">
					<![CDATA[
						/* DIMENSION 시작*/
						$ORDER_BY$
						/* DIMENSION 끝*/
					]]>
				</isEqual>
				<isEqual property="SRCTYPE" compareValue="UPPER2">
					<![CDATA[
							SCM_FAMILY_CD,
							SORT_SEQ,
							UPPER_CD1,
							UPPER_CD2
					]]>
				</isEqual>
				<isEqual property="SRCTYPE" compareValue="COLCHG">
					<![CDATA[
							SCM_FAMILY_CD,
							SORT_SEQ,
							UPPER_CD
					]]>
				</isEqual>
		</select>	
<select id="S004" parameterClass="map" resultClass="hmap" fetchSize="1000" remapresults="true">
	<isNotEqual property="CHKDASHBOARDYN" compareValue="Y"> 	
		<![CDATA[
			/* Biz: gscm.r.pm.pla.plab.db.DPLA037.S004 장당 수익성분석 조회 (sub total 적용) */
			WITH BASIC_NETDIE AS (
				SELECT /*년도 데이터*/
					$DIMORG$
					, MQHYT_GBN
					, MQHYT
					, WF_CONV_QTY AS YEAR_WF_CONV_QTY
					, DECODE(FAB_DEN_NUM, 0, 1, FAB_DEN_NUM) AS YEAR_FAB_DEN_NUM
					, NET_DIE_300_CNT AS YEAR_NET_DIE_300_CNT
			]]>
			<isEqual property="SRCTYPE" compareValue="UPPER2">
				<![CDATA[					
					, UPPER_CD1
					, UPPER_CD2
				]]>
			</isEqual>	
			<isEqual property="SRCTYPE" compareValue="COLCHG">
				<![CDATA[
					, UPPER_CD1
				]]>
			</isEqual>	
		<![CDATA[
			FROM
			(  /* 조인 상단부분 긑 체크박스의 디맨전으로 감싼다*/
				SELECT 
					$DIMORG$
					, MQHYT_GBN
					, MQHYT
					, SUM(WF_CONV_QTY) AS WF_CONV_QTY
					, MAX(FAB_DEN_NUM) AS FAB_DEN_NUM
					, MAX(NET_DIE_300_CNT) AS NET_DIE_300_CNT
				]]>	
				<isEqual property="SRCTYPE" compareValue="UPPER2">
					<![CDATA[					
						, UPPER_CD1
						, UPPER_CD2
					]]>
				</isEqual>	
				<isEqual property="SRCTYPE" compareValue="COLCHG">
					<![CDATA[
						, UPPER_CD1
					]]>
				</isEqual>	
				<![CDATA[
					FROM
					(  /* 상단 체크박스 부분 끝*/
						SELECT 
							$DIMORG$
							, MQHYT_GBN
							, MQHYT
							, SUM(WF_CONV_QTY) AS WF_CONV_QTY
							, MAX(FAB_DEN_NUM) AS FAB_DEN_NUM
							, MAX(NET_DIE_300_CNT) AS NET_DIE_300_CNT
						]]>	
						<isEqual property="SRCTYPE" compareValue="UPPER2">
							<![CDATA[					
								, UPPER_CD1
								, UPPER_CD2
							]]>
						</isEqual>	
						<isEqual property="SRCTYPE" compareValue="COLCHG">
							<![CDATA[
								, UPPER_CD1
							]]>
						</isEqual>	
							<![CDATA[
							FROM
								( /*통합DATA 원본쿼리*/
									SELECT 
										$DIMORG$
										, 'YEAR' AS MQHYT_GBN
										, TGT_YEAR AS MQHYT
										, NET_DIE_300_CNT
										]]>
								<isEqual property="SRCTYPE" compareValue="UPPER2">
									<![CDATA[					
										, T2.GTS_GVAL2 AS UPPER_CD1
										, T2.GTS_GVAL3 AS UPPER_CD2
										, T2.GTS_GVAL4 AS UPPER_CD3										
									]]>
								</isEqual>	
								<isEqual property="SRCTYPE" compareValue="COLCHG">
									<![CDATA[
										, T2.GTS_GVAL2 AS UPPER_CD1								
										, T2.GTS_GVAL4 AS UPPER_CD3
									]]>
								</isEqual><![CDATA[
									, CASE WHEN SCM_FAMILY_CD = 'DRAM' THEN
											CASE WHEN INSTR(FAB_DEN_CD, 'T') > 0 THEN TO_NUMBER(REGEXP_SUBSTR(FAB_DEN_CD, '^[0-9]+')) * 1024
											  ELSE TO_NUMBER(REGEXP_SUBSTR(FAB_DEN_CD, '^[0-9]+')) END
										ELSE 
											CASE WHEN INSTR(FAB_DEN_CD, 'T') > 0 THEN (TO_NUMBER(REGEXP_SUBSTR(FAB_DEN_CD, '^[0-9]+')) * 1024) / 8
												ELSE (TO_NUMBER(REGEXP_SUBSTR(FAB_DEN_CD, '^[0-9]+'))) / 8 END 
										END AS FAB_DEN_NUM
									, CUM2_YLD
									, BP_EXR
									/* 수량정보 */
									, ORG_QTY
									, SOM_EQ_QTY
									, SOM_DIE_QTY
									, SALE_QTY
									, COST_EQ_QTY
									, COST_DIE_QTY
									/* WAFER 환산*/
									, CASE WHEN NVL(NET_DIE_300_CNT, 0) = 0 THEN NULL
										WHEN NVL(CUM2_YLD, 0) = 0 THEN NULL
									ELSE SOM_DIE_QTY / NET_DIE_300_CNT / (CUM2_YLD / 100) END AS WF_CONV_QTY
									/* 금액 정보(USD) */  
									, SALE_AMT
									/* 원가 정보(USD) */ 
									, CASE WHEN NVL(BP_EXR, 0) = 0 THEN NULL
									ELSE VAR_COST / BP_EXR END AS VAR_COST
									, CASE WHEN NVL(BP_EXR, 0) = 0 THEN NULL
									ELSE CASH_COST / BP_EXR END AS CASH_COST
									, CASE WHEN NVL(BP_EXR, 0) = 0 THEN NULL
									ELSE COGS_COST / BP_EXR END AS COGS_COST
									, CASE WHEN NVL(BP_EXR, 0) = 0 THEN NULL
									ELSE COO_COST / BP_EXR END AS COO_COST 
									FROM PMO_PROFBLT_IMPROV_PROD T1	
									]]>	
								<isEqual property="CHKMODEYN" compareValue="Y">
								<![CDATA[
										LEFT OUTER JOIN (
											SELECT GTS_GVAL1, GTS_GVAL2, GTS_GVAL3, GTS_GVAL4, SORT_SEQ
												FROM MAD_GTS
												WHERE 1=1
												AND SYS_TYP_CD = 'R'
												AND GTS_ID = 'CODE'
												AND GTS_TYP_CD = 'P-MIX_MODE'
												AND GTS_ITEM_NM LIKE '##%'
												AND USE_YN = 'Y'
