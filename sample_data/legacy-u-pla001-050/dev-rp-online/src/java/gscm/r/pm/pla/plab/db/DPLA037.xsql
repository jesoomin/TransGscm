				, LISTAGG(', NVL(M' || WORK_YM || '_SALES_PROF_PROD_PROF / M' || WORK_YM || '_SALE_PROD_PROF * 100, 0) END AS M' || WORK_YM || '_COO_PROF_RATE_PROD @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_PROD_ST_O2
				]]>
			</isNotEqual>			
		</isEqual>
		<isNotEqual property="SEARCH_TYPE" compareValue="ODD">	
