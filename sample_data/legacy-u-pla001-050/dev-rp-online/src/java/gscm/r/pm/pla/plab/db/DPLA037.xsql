				, LISTAGG(',CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN - Q' || WORK_YEAR_QUTR || '_VAR_COST_YR_COST) / Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN END END AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_PROD_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Q' || WORK_YEAR_QUTR || '_CASH_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN - Q' || WORK_YEAR_QUTR || '_CASH_COST_YR_COST) / Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN END END AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_PROD_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN - Q' || WORK_YEAR_QUTR || '_COGS_COST_YR_COST) / Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN END END AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_PROD_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN - Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST) / Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN END END AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_PROD_PROF_ST_O
			]]>
		</isNotEqual>
			<![CDATA[				
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_VAR_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_YR_COST_ST_O
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_YR_COST_ST_O
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COGS_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_YR_COST_ST_O
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_YR_COST_ST_O
			]]>
		<isEqual property="SEARCH_TYPE" compareValue="ODD">
			<isEqual property="CHK_SUBTOTAL" compareValue="Y">	
				<![CDATA[
				/*영업이익률 MAX*/
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF,0) = 0 THEN 0 ELSE NVL( Q' || WORK_YEAR_QUTR || '_SALES_PROF_WF_SLS_PROF / Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF * 100, 0) END ELSE CASE WHEN NVL( Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF, 0) = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_WF_SLS_PROF/ Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(,NVL(((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF( Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN, 0)) - ( Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST / NULLIF( Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN, 0))) / NULLIF((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF(Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_WF_ST_O2				
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF,0) = 0 THEN 0 ELSE NVL( Q' || WORK_YEAR_QUTR || '_SALES_PROF_EQ_PROF / Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF * 100, 0) END ELSE CASE WHEN NVL( Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF, 0) = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_EQ_PROF/ Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_EQ_ST_O1
				, LISTAGG(,NVL(((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN, 0)) - ( Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN, 0))) / NULLIF((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF(Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_EQ_ST_O2				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF,0) = 0 THEN 0 ELSE NVL( Q' || WORK_YEAR_QUTR || '_SALES_PROF_DIE_PROF / Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF * 100, 0) END ELSE CASE WHEN NVL( Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF, 0) = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_DIE_PROF/ Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_DIE_ST_O1
				, LISTAGG(,NVL(((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN, 0)) - ( Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN, 0))) / NULLIF((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF(Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_DIE_ST_O2				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF,0) = 0 THEN 0 ELSE NVL( Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF / Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF * 100, 0) END ELSE CASE WHEN NVL( Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF, 0) = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF/ Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_PROD_ST_O1
				, LISTAGG(,NVL(((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_PROD_QTY_SALE_PLN, 0)) - ( Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_PROD_QTY_SALE_PLN, 0))) / NULLIF((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF(Q' || WORK_YEAR_QUTR || '_SOM_PROD_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_PROD_ST_O2				
				]]>
			</isEqual>	
			<isNotEqual property="CHK_SUBTOTAL" compareValue="Y">	
				<![CDATA[
				/*영업이익률 MAX*/
				, LISTAGG(', CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(', NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_WF_SLS_PROF / Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF * 100, 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_WF_ST_O2

				, LISTAGG(', CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_EQ_ST_O1
				, LISTAGG(', NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_EQ_PROF / Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF * 100, 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_EQ @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_EQ_ST_O2
				, LISTAGG(', CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_DIE_ST_O1
				, LISTAGG(', NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_DIE_PROF / Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF * 100, 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_DIE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_DIE_ST_O2
				, LISTAGG(', CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_PROD_ST_O1
				, LISTAGG(', NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF / Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF * 100, 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_PROD @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_PROD_ST_O2
				]]>
			</isNotEqual>			
		</isEqual>
		<isNotEqual property="SEARCH_TYPE" compareValue="ODD">	
				<![CDATA[
				/*영업이익률 MAX*/
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF, 0) = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_WF_SLS_PROF/Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(,NVL(((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF( Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN, 0)) - ( Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST / NULLIF( Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN, 0))) / NULLIF((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF(Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_WF_ST_O2				
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF, 0) = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_EQ_PROF/Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_EQ_ST_O1				
				, LISTAGG(,NVL(((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN, 0)) - ( Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN, 0))) / NULLIF((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF(Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_EQ_ST_O2				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF, 0) = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_DIE_PROF/Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_DIE_ST_O1				
				, LISTAGG(,NVL(((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN, 0)) - ( Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN, 0))) / NULLIF((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF(Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_DIE_ST_O2				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF, 0) = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF/Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_PROD_ST_O1				
				, LISTAGG(,NVL(((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_PROD_QTY_SALE_PLN, 0)) - ( Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST / NULLIF( Q' || WORK_YEAR_QUTR || '_SOM_PROD_QTY_SALE_PLN, 0))) / NULLIF((Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / NULLIF(Q' || WORK_YEAR_QUTR || '_SOM_PROD_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_PROD_ST_O2				
				]]>
		</isNotEqual>				
				<![CDATA[
				/*연간 영업이익률*/
				, LISTAGG(', NVL(( Q' || WORK_YEAR_QUTR || '_SALES_PROF_YR_PROF / NULLIF( Q' || WORK_YEAR_QUTR || '_SALE_YR_PROF, 0)) * 100, 0) AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_YR', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_YR_ST_O
				, 2 AS SEQ
			FROM (
				SELECT WORK_YEAR_QUTR FROM MAD_CALENDAR 
				WHERE WORK_YM >= #FROM_YM#
				AND WORK_YM <= #TO_YM#
				GROUP BY WORK_YEAR_QUTR
			)	
			WHERE 'Y' = #DISPLAY_QUATER#	
			UNION ALL	
						SELECT LISTAGG(',(''HALF'', ''' || WORK_YEAR_HALF || ''') AS H' || WORK_YEAR_HALF, ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS PIVOT_STR
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CUM2_YLD_MASTER_DATA, 0) AS H' || WORK_YEAR_HALF || '_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CUM2_YLD_MASTER_DATA
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_ODD_CUM2_YLD_MASTER_DATA, 0) AS H' || WORK_YEAR_HALF || '_ODD_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ODD_CUM2_YLD_MASTER_DATA
				, LISTAGG(',NVL(TRIM(H' || WORK_YEAR_HALF || '_GOOD_DIE_MASTER_DATA), '' '') AS H' || WORK_YEAR_HALF || '_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS GOOD_DIE_MASTER_DATA
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_ODD_GOOD_DIE_MASTER_DATA, 0) AS H' || WORK_YEAR_HALF || '_ODD_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ODD_GOOD_DIE_MASTER_DATA
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) AS H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS WF_CONV_QTY_SALE_PLN
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) AS H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SOM_EQ_QTY_SALE_PLN
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) AS H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SOM_DIE_QTY_SALE_PLN
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) AS H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ORG_QTY_SALE_PLN
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN, 0) AS H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_AMT_SALE_PLN
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_ASP_SALE_PLN, 0) AS H' || WORK_YEAR_HALF || '_ASP_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ASP_SALE_PLN
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_GRAV_SALE_PLN, 0) AS H' || WORK_YEAR_HALF || '_SALE_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_GRAV_SALE_PLN
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_QTY_GRAV_SALE_PLN, 0) AS H' || WORK_YEAR_HALF || '_QTY_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS QTY_GRAV_SALE_PLN
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_GRAV_SALE_PLN, 0) AS H' || WORK_YEAR_HALF || '_SALES_PROF_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_GRAV_SALE_PLN
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_WF_SLS_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CNTRB_PROF_WF_SLS_PROF, 0) AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_PROF_WF_SLS_PROF, 0) AS H' || WORK_YEAR_HALF || '_CASH_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_WF_SLS_PROF				
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_PROF_WF_SLS_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALE_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_EQ_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALE_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_EQ_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CNTRB_PROF_EQ_PROF, 0) AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_EQ_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_PROF_EQ_PROF, 0) AS H' || WORK_YEAR_HALF || '_CASH_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_EQ_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_PROF_EQ_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALE_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_EQ_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_EQ_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_DIE_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALE_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_DIE_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CNTRB_PROF_DIE_PROF, 0) AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_DIE_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_PROF_DIE_PROF, 0) AS H' || WORK_YEAR_HALF || '_CASH_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_DIE_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_PROF_DIE_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALE_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_DIE_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_DIE_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_PROD_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALE_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROD_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CNTRB_PROF_PROD_PROF, 0) AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_PROD_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_PROF_PROD_PROF, 0) AS H' || WORK_YEAR_HALF || '_CASH_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_PROD_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_PROF_PROD_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALE_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_PROD_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_PROD_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_YR_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALE_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_YR_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CNTRB_PROF_YR_PROF, 0) AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_YR_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_PROF_YR_PROF, 0) AS H' || WORK_YEAR_HALF || '_CASH_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_YR_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALE_PROF_YR_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALE_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_YR_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_SALES_PROF_YR_PROF, 0) AS H' || WORK_YEAR_HALF || '_SALES_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_YR_PROF
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_VAR_COST_WF_SLS_COST, 0) AS H' || WORK_YEAR_HALF || '_VAR_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_WF_SLS_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_COST_WF_SLS_COST, 0) AS H' || WORK_YEAR_HALF || '_CASH_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_WF_SLS_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COGS_COST_WF_SLS_COST, 0) AS H' || WORK_YEAR_HALF || '_COGS_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_WF_SLS_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COO_COST_WF_SLS_COST, 0) AS H' || WORK_YEAR_HALF || '_COO_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_WF_SLS_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_VAR_COST_EQ_COST, 0) AS H' || WORK_YEAR_HALF || '_VAR_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_EQ_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_COST_EQ_COST, 0) AS H' || WORK_YEAR_HALF || '_CASH_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_EQ_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COGS_COST_EQ_COST, 0) AS H' || WORK_YEAR_HALF || '_COGS_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_EQ_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COO_COST_EQ_COST, 0) AS H' || WORK_YEAR_HALF || '_COO_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_EQ_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_VAR_COST_DIE_COST, 0) AS H' || WORK_YEAR_HALF || '_VAR_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_DIE_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_COST_DIE_COST, 0) AS H' || WORK_YEAR_HALF || '_CASH_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_DIE_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COGS_COST_DIE_COST, 0) AS H' || WORK_YEAR_HALF || '_COGS_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_DIE_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COO_COST_DIE_COST, 0) AS H' || WORK_YEAR_HALF || '_COO_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_DIE_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_VAR_COST_PROD_COST, 0) AS H' || WORK_YEAR_HALF || '_VAR_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_PROD_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_COST_PROD_COST, 0) AS H' || WORK_YEAR_HALF || '_CASH_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_PROD_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COGS_COST_PROD_COST, 0) AS H' || WORK_YEAR_HALF || '_COGS_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_PROD_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COO_COST_PROD_COST, 0) AS H' || WORK_YEAR_HALF || '_COO_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_PROD_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST, 0) AS H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_YR_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST, 0) AS H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_YR_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST, 0) AS H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_YR_COST
				, LISTAGG(',NVL(H' || WORK_YEAR_HALF || '_COO_COST_YR_COST, 0) AS H' || WORK_YEAR_HALF || '_COO_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_YR_COST
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF,0) = 0 THEN 0 ELSE NVL( H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF / H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF * 100, 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_WF
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_EQ_PROF,0) = 0 THEN 0 ELSE NVL( H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF / H' || WORK_YEAR_HALF || '_SALE_EQ_PROF * 100, 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_EQ ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_EQ
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_DIE_PROF,0) = 0 THEN 0 ELSE NVL( H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF / H' || WORK_YEAR_HALF || '_SALE_DIE_PROF * 100, 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_DIE ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_DIE
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_PROD_PROF,0) = 0 THEN 0 ELSE NVL( H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF / H' || WORK_YEAR_HALF || '_SALE_PROD_PROF * 100, 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_PROD ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_PROD
				/*영업이익률(연간 영업이익 / 연간 매출액)*/
				, LISTAGG(', CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SALE_YR_PROF,0) = 0 THEN 0 ELSE NVL( H' || WORK_YEAR_HALF || '_SALES_PROF_YR_PROF / H' || WORK_YEAR_HALF || '_SALE_YR_PROF * 100, 0) END AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_YR ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_YR
				
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CUM2_YLD_MASTER_DATA) AS H' || WORK_YEAR_HALF || '_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CUM2_YLD_MASTER_DATA_ST				
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_ODD_CUM2_YLD_MASTER_DATA) AS H' || WORK_YEAR_HALF || '_ODD_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ODD_CUM2_YLD_MASTER_DATA_ST
				, LISTAGG(',MAX(H' || WORK_YEAR_HALF || '_GOOD_DIE_MASTER_DATA) AS H' || WORK_YEAR_HALF || '_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS GOOD_DIE_MASTER_DATA_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_ODD_GOOD_DIE_MASTER_DATA) AS H' || WORK_YEAR_HALF || '_ODD_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ODD_GOOD_DIE_MASTER_DATA_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN) AS H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS WF_CONV_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN) AS H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SOM_EQ_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN) AS H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SOM_DIE_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN) AS H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ORG_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN) AS H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_AMT_SALE_PLN_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_ASP_SALE_PLN) AS H' || WORK_YEAR_HALF || '_ASP_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ASP_SALE_PLN_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_GRAV_SALE_PLN) AS H' || WORK_YEAR_HALF || '_SALE_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_QTY_GRAV_SALE_PLN) AS H' || WORK_YEAR_HALF || '_QTY_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS QTY_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALES_PROF_GRAV_SALE_PLN) AS H' || WORK_YEAR_HALF || '_SALES_PROF_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF) AS H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_WF_SLS_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CNTRB_PROF_WF_SLS_PROF) AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CASH_PROF_WF_SLS_PROF) AS H' || WORK_YEAR_HALF || '_CASH_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_WF_SLS_PROF_ST				
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_PROF_WF_SLS_PROF) AS H' || WORK_YEAR_HALF || '_SALE_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF) AS H' || WORK_YEAR_HALF || '_SALES_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_EQ_PROF) AS H' || WORK_YEAR_HALF || '_SALE_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_EQ_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CNTRB_PROF_EQ_PROF) AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CASH_PROF_EQ_PROF) AS H' || WORK_YEAR_HALF || '_CASH_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_PROF_EQ_PROF) AS H' || WORK_YEAR_HALF || '_SALE_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF) AS H' || WORK_YEAR_HALF || '_SALES_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_DIE_PROF) AS H' || WORK_YEAR_HALF || '_SALE_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_DIE_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CNTRB_PROF_DIE_PROF) AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CASH_PROF_DIE_PROF) AS H' || WORK_YEAR_HALF || '_CASH_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_PROF_DIE_PROF) AS H' || WORK_YEAR_HALF || '_SALE_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF) AS H' || WORK_YEAR_HALF || '_SALES_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_PROD_PROF) AS H' || WORK_YEAR_HALF || '_SALE_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROD_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CNTRB_PROF_PROD_PROF) AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CASH_PROF_PROD_PROF) AS H' || WORK_YEAR_HALF || '_CASH_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_PROF_PROD_PROF) AS H' || WORK_YEAR_HALF || '_SALE_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF) AS H' || WORK_YEAR_HALF || '_SALES_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_YR_PROF) AS H' || WORK_YEAR_HALF || '_SALE_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_YR_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CNTRB_PROF_YR_PROF) AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_YR_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CASH_PROF_YR_PROF) AS H' || WORK_YEAR_HALF || '_CASH_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_YR_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALE_PROF_YR_PROF) AS H' || WORK_YEAR_HALF || '_SALE_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_YR_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_SALES_PROF_YR_PROF) AS H' || WORK_YEAR_HALF || '_SALES_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_YR_PROF_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_VAR_COST_WF_SLS_COST) AS H' || WORK_YEAR_HALF || '_VAR_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CASH_COST_WF_SLS_COST) AS H' || WORK_YEAR_HALF || '_CASH_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_COGS_COST_WF_SLS_COST) AS H' || WORK_YEAR_HALF || '_COGS_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_COO_COST_WF_SLS_COST) AS H' || WORK_YEAR_HALF || '_COO_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_VAR_COST_EQ_COST) AS H' || WORK_YEAR_HALF || '_VAR_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_EQ_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CASH_COST_EQ_COST) AS H' || WORK_YEAR_HALF || '_CASH_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_EQ_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_COGS_COST_EQ_COST) AS H' || WORK_YEAR_HALF || '_COGS_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_EQ_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_COO_COST_EQ_COST) AS H' || WORK_YEAR_HALF || '_COO_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_EQ_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_VAR_COST_DIE_COST) AS H' || WORK_YEAR_HALF || '_VAR_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_DIE_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CASH_COST_DIE_COST) AS H' || WORK_YEAR_HALF || '_CASH_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_DIE_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_COGS_COST_DIE_COST) AS H' || WORK_YEAR_HALF || '_COGS_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_DIE_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_COO_COST_DIE_COST) AS H' || WORK_YEAR_HALF || '_COO_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_DIE_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_VAR_COST_PROD_COST) AS H' || WORK_YEAR_HALF || '_VAR_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_PROD_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CASH_COST_PROD_COST) AS H' || WORK_YEAR_HALF || '_CASH_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_PROD_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_COGS_COST_PROD_COST) AS H' || WORK_YEAR_HALF || '_COGS_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_PROD_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_COO_COST_PROD_COST) AS H' || WORK_YEAR_HALF || '_COO_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_PROD_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST) AS H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_YR_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST) AS H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_YR_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST) AS H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_YR_COST_ST
				, LISTAGG(',SUM(H' || WORK_YEAR_HALF || '_COO_COST_YR_COST) AS H' || WORK_YEAR_HALF || '_COO_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_YR_COST_ST
				/*영업이익률 MAX(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(',MAX(H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF) AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_WF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_WF_ST
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(',MAX(H' || WORK_YEAR_HALF || '_COO_PROF_RATE_EQ) AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_EQ ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_EQ_ST				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(',MAX(H' || WORK_YEAR_HALF || '_COO_PROF_RATE_DIE) AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_DIE ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_DIE_ST				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(',MAX(H' || WORK_YEAR_HALF || '_COO_PROF_RATE_PROD) AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_PROD ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_PROD_ST				
				/*영업이익률(연간 영업이익 / 연간 매출액)*/
				, LISTAGG(',MAX(H' || WORK_YEAR_HALF || '_COO_PROF_RATE_YR) AS H' || WORK_YEAR_HALF || '_COO_PROF_RATE_YR ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_PROF_RATE_YR_ST

				, LISTAGG(',H' || WORK_YEAR_HALF || '_CUM2_YLD_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CUM2_YLD_MASTER_DATA_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_ODD_CUM2_YLD_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ODD_CUM2_YLD_MASTER_DATA_ST_O
				, LISTAGG(',CASE WHEN H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN = 0 THEN ''0'' ELSE CASE WHEN GRP_ID > 0 THEN TO_CHAR(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN / H' || WORK_YEAR_HALF || '_GOOD_DIE_MASTER_DATA END END AS H' || WORK_YEAR_HALF || '_GOOD_DIE_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS GOOD_DIE_MASTER_DATA_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_ODD_GOOD_DIE_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ODD_GOOD_DIE_MASTER_DATA_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS WF_CONV_QTY_SALE_PLN_ST_O				
				, LISTAGG(',H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SOM_EQ_QTY_SALE_PLN_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SOM_DIE_QTY_SALE_PLN_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ORG_QTY_SALE_PLN_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_AMT_SALE_PLN_ST_O
				, LISTAGG(',CASE WHEN H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) END AS H' || WORK_YEAR_HALF || '_ASP_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS ASP_SALE_PLN_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_SALE_GRAV_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_GRAV_SALE_PLN_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_QTY_GRAV_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS QTY_GRAV_SALE_PLN_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_SALES_PROF_GRAV', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_GRAV_ST_O
				, LISTAGG(',CASE WHEN H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) END AS H' || WORK_YEAR_HALF || '_SALE_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_WF_SLS_PROF_ST_O
				, LISTAGG(',CASE WHEN H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) END AS H' || WORK_YEAR_HALF || '_SALE_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) END AS H' || WORK_YEAR_HALF || '_SALE_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_DIE_PROF_ST_O
				, LISTAGG(',CASE WHEN H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) END AS H' || WORK_YEAR_HALF || '_SALE_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROD_PROF_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_SALE_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_YR_PROF_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_CNTRB_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_YR_PROF_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_CASH_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_PROF_YR_PROF_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_SALE_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALE_PROF_YR_PROF_ST_O
				, LISTAGG(',H' || WORK_YEAR_HALF || '_SALES_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS SALES_PROF_YR_PROF_ST_O
			]]>
	<isEqual property="SEARCH_TYPE" compareValue="ODD">
		<isEqual property="CHK_SUBTOTAL" compareValue="Y">		
			<![CDATA[
				/*장당 원가*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_VAR_COST_WF_SLS_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST / H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_VAR_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_WF_SLS_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_CASH_COST_WF_SLS_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST / H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CASH_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_WF_SLS_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_COGS_COST_WF_SLS_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST / H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COGS_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_WF_SLS_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_COO_COST_WF_SLS_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COO_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_WF_SLS_COST_ST_O
				/*EQ 원가*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_VAR_COST_EQ_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_VAR_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_EQ_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_CASH_COST_EQ_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CASH_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_EQ_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_COGS_COST_EQ_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COGS_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_EQ_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_COO_COST_EQ_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_EQ_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COO_COST_EQ_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_EQ_COST_ST_O
				/*DIE 원가*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_VAR_COST_DIE_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_VAR_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_DIE_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_CASH_COST_DIE_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CASH_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_DIE_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_COGS_COST_DIE_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COGS_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_DIE_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_COO_COST_DIE_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / H' || WORK_YEAR_HALF || '_SOM_DIE_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COO_COST_DIE_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_DIE_COST_ST_O
				/*제품 원가*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_VAR_COST_PROD_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_VAR_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS VAR_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_CASH_COST_PROD_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_CASH_COST_YR_COST / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CASH_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CASH_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_COGS_COST_PROD_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COGS_COST_YR_COST / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COGS_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COGS_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_COO_COST_PROD_COST ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE H' || WORK_YEAR_HALF || '_COO_COST_YR_COST / H' || WORK_YEAR_HALF || '_ORG_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_COO_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS COO_COST_PROD_COST_ST_O
				/*장당 수익성*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN H' || WORK_YEAR_HALF || '_CNTRB_PROF_WF_SLS_PROF ELSE CASE WHEN NVL(H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(H' || WORK_YEAR_HALF || '_CNTRB_PROF_WF_SLS_PROF, 0) = 0 THEN 0 ELSE (H' || WORK_YEAR_HALF || '_SALE_AMT_SALE_PLN - H' || WORK_YEAR_HALF || '_VAR_COST_YR_COST) / H' || WORK_YEAR_HALF || '_WF_CONV_QTY_SALE_PLN END END AS H' || WORK_YEAR_HALF || '_CNTRB_PROF_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_HALF) AS CNTRB_PROF_WF_SLS_PROF_ST_O
