										$GROUPING_NETDIE3$
										$GROUPING_NETDIE5$
									</isEqual>
									<isEqual property="SRCTYPE" compareValue="UPPER2">
										<![CDATA[
												SCM_FAMILY_CD ,
												UPPER_CD1 ,
												UPPER_CD2 ,
												GROUPING(SCM_FAMILY_CD) + GROUPING(UPPER_CD1) + GROUPING(UPPER_CD2) AS GRP_ID
										]]>
									</isEqual>	
									<isEqual property="SRCTYPE" compareValue="COLCHG">
										<![CDATA[
												SCM_FAMILY_CD ,
												UPPER_CD1 ,
												GROUPING(SCM_FAMILY_CD) + GROUPING(UPPER_CD1) AS GRP_ID
										]]>
									</isEqual><![CDATA[																				
											, MQHYT											
											, MAX(YEAR_FAB_DEN_NUM) AS YEAR_FAB_DEN_NUM 
											, MAX(YEAR_WF_CONV_QTY) AS YEAR_WF_CONV_QTY
											FROM BASIC_NETDIE
											GROUP BY ROLLUP (										
												]]>	
									<isEqual property="SRCTYPE" compareValue="BASE">
										$GROUPING_NETDIE3$
									</isEqual>
									<isEqual property="SRCTYPE" compareValue="UPPER2">
										<![CDATA[
