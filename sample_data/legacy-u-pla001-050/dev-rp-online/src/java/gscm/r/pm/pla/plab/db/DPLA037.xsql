		<![CDATA[
			, TO_NUMBER(MONTHS_BETWEEN(TO_DATE(#TO_YM#, 'YYYYMM'), TO_DATE(#FROM_YM#, 'YYYYMM'))) + 1 AS MONTH_BETWEEN
			, #FROM_YM# AS START_MONTH
			, #TO_YM# AS END_MONTH
			, (SELECT MIN(WORK_YEAR_QUTR)
				FROM (
					SELECT WORK_YEAR_QUTR
							, WORK_YEAR_HALF
							, WORK_YEAR
						FROM MAD_CALENDAR
						WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
					)
				) AS START_QUARTER
			, (SELECT MIN(WORK_YEAR_HALF)
				FROM (
					SELECT WORK_YEAR_QUTR
							, WORK_YEAR_HALF
							, WORK_YEAR
						FROM MAD_CALENDAR
						WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
					)
				) AS START_HALF
			, (SELECT MIN(WORK_YEAR)
				FROM (
					SELECT WORK_YEAR_QUTR
							, WORK_YEAR_HALF
							, WORK_YEAR
						FROM MAD_CALENDAR
						WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
					)
				) AS START_YEAR	
			, (
				SELECT COUNT(*)
					FROM (
							SELECT DISTINCT WORK_YM
							FROM MAD_CALENDAR
							WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
							AND 'Y' = #DISPLAY_MONTH#
						UNION ALL
							SELECT DISTINCT WORK_YEAR_QUTR
							FROM MAD_CALENDAR
							WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
							AND 'Y' = #DISPLAY_QUARTER#
						UNION ALL
							SELECT DISTINCT WORK_YEAR_HALF
							FROM MAD_CALENDAR
							WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
							AND 'Y' = #DISPLAY_HALF#
						UNION ALL
							SELECT DISTINCT WORK_YEAR
							FROM MAD_CALENDAR
							WHERE WORK_YM BETWEEN #FROM_YM#	AND #TO_YM#
							AND 'Y' = #DISPLAY_YEAR#		
						)
			) AS COLUMN_COUNT
			, (
				SELECT START_GUBUN
					FROM (
						SELECT START_GUBUN
							FROM (
								SELECT 'YM' AS START_GUBUN
										, 1 AS SEQ
										FROM DUAL
										WHERE 'Y' = #DISPLAY_MONTH#
							UNION ALL
								SELECT 'QUARTER' AS START_GUBUN
										, 2 AS SEQ
										FROM DUAL
										WHERE 'Y' = #DISPLAY_QUARTER#
							UNION ALL
								SELECT 'HALF' AS START_GUBUN
										, 3 AS SEQ
										FROM DUAL
										WHERE 'Y' = #DISPLAY_HALF#
							UNION ALL
								SELECT 'YEAR' AS START_GUBUN
										, 4 AS SEQ
										FROM DUAL
										WHERE 'Y' = #DISPLAY_YEAR#										
							)
						ORDER BY SEQ	
					)
				WHERE ROWNUM <= 1	
			) AS START_GUBUN
			, #PLN_VER#	AS PLN_REV
			, (SELECT PLN_YW FROM PMI_PLN_REV WHERE PLN_REV = #PLN_VER#) AS PLN_YW	
			, 'ORG' AS DATA_GBN_CD
			, (SELECT PLN_YM FROM PMI_PLN_REV WHERE PLN_REV = #PLN_VER#) AS PLN_YM
			$DIM_OUTER_SEQ$ 
			, GRP_ID
			FROM (
				SELECT 
		]]><isEqual property="SRCTYPE" compareValue="BASE">
			<![CDATA[
				$DIM_OUTER$
				, $DIM_GROUP$ AS GRP_ID
			]]>
		</isEqual>
		<isEqual property="SRCTYPE" compareValue="UPPER2">
			<![CDATA[
					T1.SCM_FAMILY_CD,
					MAX(SORT_SEQ) AS SORT_SEQ,
					T1.UPPER_CD1,
					T1.UPPER_CD2,
					GROUPING(T1.SCM_FAMILY_CD) + GROUPING(T1.UPPER_CD1) + GROUPING(T1.UPPER_CD2) AS GRP_ID
			]]>
		</isEqual>
		<isEqual property="SRCTYPE" compareValue="COLCHG">
			<![CDATA[
					T1.SCM_FAMILY_CD,
					MAX(SORT_SEQ) AS SORT_SEQ,
					T1.UPPER_CD1,
					GROUPING(T1.SCM_FAMILY_CD) + GROUPING(T1.UPPER_CD1) AS GRP_ID
			]]>
		</isEqual>
			<![CDATA[
				MAX(NET_DIE) AS NET_DIE
				$CUM2_YLD_MASTER_DATA_ST$
				$ODD_CUM2_YLD_MASTER_DATA_ST$
				$GOOD_DIE_MASTER_DATA_ST$
				$ODD_GOOD_DIE_MASTER_DATA_ST$
				$WF_CONV_QTY_SALE_PLN_ST$
