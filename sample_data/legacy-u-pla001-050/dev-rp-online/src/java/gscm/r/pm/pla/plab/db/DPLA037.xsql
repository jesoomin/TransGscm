				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALE_PROF_DIE_PROF, 0) AS Y' || WORK_YEAR || '_SALE_PROF_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_DIE_PROF_ST_O
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF, 0) AS Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_DIE_PROF_ST_O
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CNTRB_PROF_PROD_PROF, 0) AS Y' || WORK_YEAR || '_CNTRB_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_PROD_PROF_ST_O
