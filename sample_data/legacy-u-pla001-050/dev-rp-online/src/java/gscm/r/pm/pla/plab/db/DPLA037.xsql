				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE Y' || WORK_YEAR || '_CASH_COST_YR_COST / Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_CASH_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE Y' || WORK_YEAR || '_COGS_COST_YR_COST / Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_COGS_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_PROD_COST_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE Y' || WORK_YEAR || '_COO_COST_YR_COST / Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_COO_COST_PROD_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_PROD_COST_ST_O
				/*장당 수익성*/
