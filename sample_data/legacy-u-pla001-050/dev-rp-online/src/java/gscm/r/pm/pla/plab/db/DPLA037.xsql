	<select id="S005" parameterClass="map" resultClass="hmap" fetchSize="50" remapresults="true">
		<![CDATA[
		/* Biz: gscm.r.pm.pla.plab.db.DPLA037.S005 장당 수익성 업데이트 시각 조회 */
		SELECT TO_CHAR(A.CRT_TM, 'YYYY-MM-DD HH24:MI:SS') AS CRT_TM
			FROM PMO_PROFBLT_IMPROV_PROD A
			WHERE PLN_REV = #PLN_VER#
			AND DATA_GBN_CD = 'ORG'
			AND ROWNUM = 1
		]]>	
	</select>
	<select id="S006" parameterClass="map" resultClass="hmap" fetchSize="50" remapresults="true">
		<![CDATA[
		/* Biz: gscm.r.pm.pla.plab.db.DPLA037.S006 REV 기간 조회 */
		SELECT DISTINCT B.PLN_REV
				, WORK_YEAR
				, PLN_START_YM
				, PLN_END_YM
			FROM MAD_CALENDAR A
			(SELECT PLN_REV
				, PLN_START_YM
				, PLN_END_YM
			FROM PMI_PLN_REV A
			WHERE PLN_YW = #PLN_YW#
			) B
			WHERE WORK_YM BETWEEN B.PLN_START_YM AND B.PLN_END_YM
			ORDER BY B.PLN_REV, WORK_YEAR
		]]>	
	</select>
</sqlMap>

