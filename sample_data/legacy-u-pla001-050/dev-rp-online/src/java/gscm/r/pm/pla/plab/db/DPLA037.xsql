														AND GTS_ID = 'P-MIX EXPT_LIST'
														AND GTS_ITEM_NM LIKE '##%'
														AND USE_YN = 'Y')
												AND PLN_YW = (SELECT PLN_YW FROM PMI_PLN_REV WHERE PLN_REV = #PLN_VER#)
												AND SCM_FAMILY_CD = #TYPE#
												AND DATA_GBN_CD = 'ORG'
												AND TGT_YM BETWEEN #FROM_YM# AND #TO_YM#
								]]>	
								<isNotEmpty prepend="AND TECH_CD" property="ARR_TECH_CD">
									<iterate prepend="IN" property="ARR_TECH_CD" open="(" close=")" conjunction=",">
										<![CDATA[
											#ARR_TECH_CD[]#
										]]>
									</iterate>
								</isNotEmpty>
								<isNotEmpty prepend="AND FAB_DEN_CD" property="ARR_FAB_DEN_CD">
									<iterate prepend="IN" property="ARR_FAB_DEN_CD" open="(" close=")" conjunction=",">
										<![CDATA[
											#ARR_FAB_DEN_CD[]#
										]]>
									</iterate>
								</isNotEmpty>
								<isNotEmpty prepend="AND CHG_PROD_MODE_CD" property="ARR_CHG_PROD_MODE_CD">
									<iterate prepend="IN" property="ARR_CHG_PROD_MODE_CD" open="(" close=")" conjunction=",">
										<![CDATA[
											#ARR_CHG_PROD_MODE_CD[]#
										]]>
									</iterate>
								</isNotEmpty>
								<isNotEmpty prepend="AND APP_LVL_1_CD" property="ARR_APP_LVL_1_CD">
									<iterate prepend="IN" property="ARR_APP_LVL_1_CD" open="(" close=")" conjunction=",">
										<![CDATA[
											#ARR_APP_LVL_1_CD[]#
										]]>
									</iterate>
								</isNotEmpty>
								<isNotEmpty prepend="AND PKG_TYP_CD2" property="ARR_PKG_TYP_CD2">
									<iterate prepend="IN" property="ARR_PKG_TYP_CD2" open="(" close=")" conjunction=",">
										<![CDATA[
											#ARR_PKG_TYP_CD2[]#
										]]>
									</iterate>
								</isNotEmpty>
								<isEqual property="TYPE" compareValue="NAND">
									<isNotEmpty prepend="AND CELL_LAYER_TYP_CD" property="ARR_CELL_LAYER_TYP_CD">
										<iterate prepend="IN" property="ARR_CELL_LAYER_TYP_CD" open="(" close=")" conjunction=",">
											<![CDATA[
												#ARR_CELL_LAYER_TYP_CD[]#
											]]>
										</iterate>
									</isNotEmpty>
								</isEqual>
							<![CDATA[
											)
									GROUP BY /* DIMENSION 시작*/
												$DIMORG$
												, MQHYT_GBN
												, MQHYT
											/* DIMENSION 끝*/
							]]>
							<isEqual property="SRCTYPE" compareValue="UPPER2">
									<![CDATA[
											, UPPER_CD1
											, UPPER_CD2
									]]>
							</isEqual>	
