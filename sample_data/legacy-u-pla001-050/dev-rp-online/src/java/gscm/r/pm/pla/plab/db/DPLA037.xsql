				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_CASH_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_CASH_COST_YR_COST) / Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_CASH_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_PROD_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_SALE_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_COGS_COST_YR_COST) / Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_SALE_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_PROD_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_COO_COST_YR_COST) / Y' || WORK_YEAR || '_ORG_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_PROD_PROF_ST_O
			]]>
		</isNotEqual>
			<![CDATA[				
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_VAR_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS VAR_COST_YR_COST_ST_O
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_CASH_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_COST_YR_COST_ST_O
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COGS_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COGS_COST_YR_COST_ST_O
				, LISTAGG(',NVL(Y' || WORK_YEAR || '_COO_COST_YR_COST, ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_COST_YR_COST_ST_O
			]]>
		<isEqual property="SEARCH_TYPE" compareValue="ODD">
			<isEqual property="CHK_SUBTOTAL" compareValue="Y">	
				<![CDATA[
				/*영업이익률 MAX*/
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_WF_SLS_PROF,0) = 0 THEN 0 ELSE NVL( Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF / Y' || WORK_YEAR || '_SALE_WF_SLS_PROF * 100, 0) END ELSE CASE WHEN NVL( Y' || WORK_YEAR || '_SALE_WF_SLS_PROF, 0) = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF/ Y' || WORK_YEAR || '_SALE_WF_SLS_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(,NVL(((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF( Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0)) - ( Y' || WORK_YEAR || '_COO_COST_YR_COST / NULLIF( Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0))) / NULLIF((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF(Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_WF_ST_O2				
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_EQ_PROF,0) = 0 THEN 0 ELSE NVL( Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF / Y' || WORK_YEAR || '_SALE_EQ_PROF * 100, 0) END ELSE CASE WHEN NVL( Y' || WORK_YEAR || '_SALE_EQ_PROF, 0) = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF/ Y' || WORK_YEAR || '_SALE_EQ_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_EQ_ST_O1
				, LISTAGG(,NVL(((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF( Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0)) - ( Y' || WORK_YEAR || '_COO_COST_YR_COST / NULLIF( Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0))) / NULLIF((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF(Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_EQ_ST_O2				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_DIE_PROF,0) = 0 THEN 0 ELSE NVL( Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF / Y' || WORK_YEAR || '_SALE_DIE_PROF * 100, 0) END ELSE CASE WHEN NVL( Y' || WORK_YEAR || '_SALE_DIE_PROF, 0) = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF/ Y' || WORK_YEAR || '_SALE_DIE_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_DIE_ST_O1
				, LISTAGG(,NVL(((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF( Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0)) - ( Y' || WORK_YEAR || '_COO_COST_YR_COST / NULLIF( Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0))) / NULLIF((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF(Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_DIE_ST_O2				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN GRP_ID = 0 THEN CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_PROD_PROF,0) = 0 THEN 0 ELSE NVL( Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF / Y' || WORK_YEAR || '_SALE_PROD_PROF * 100, 0) END ELSE CASE WHEN NVL( Y' || WORK_YEAR || '_SALE_PROD_PROF, 0) = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF/ Y' || WORK_YEAR || '_SALE_PROD_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_PROD_ST_O1
				, LISTAGG(,NVL(((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF( Y' || WORK_YEAR || '_SOM_PROD_QTY_SALE_PLN, 0)) - ( Y' || WORK_YEAR || '_COO_COST_YR_COST / NULLIF( Y' || WORK_YEAR || '_SOM_PROD_QTY_SALE_PLN, 0))) / NULLIF((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF(Y' || WORK_YEAR || '_SOM_PROD_QTY_SALE_PLN, 0)), 0) * 100 , 0) END END AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_PROD_ST_O2				
				]]>
			</isEqual>	
			<isNotEqual property="CHK_SUBTOTAL" compareValue="Y">	
				<![CDATA[
				/*영업이익률 MAX*/
				, LISTAGG(', CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_WF_SLS_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(', NVL(Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF / Y' || WORK_YEAR || '_SALE_WF_SLS_PROF * 100, 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_WF_ST_O2

				, LISTAGG(', CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_EQ_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_EQ_ST_O1
				, LISTAGG(', NVL(Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF / Y' || WORK_YEAR || '_SALE_DIE_PROF * 100, 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_EQ @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_EQ_ST_O2
				, LISTAGG(', CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_DIE_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_DIE_ST_O1
				, LISTAGG(', NVL(Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF / Y' || WORK_YEAR || '_SALE_DIE_PROF * 100, 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_DIE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_DIE_ST_O2
				, LISTAGG(', CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_PROD_PROF,0) = 0 THEN 0  ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_PROD_ST_O1
				, LISTAGG(', NVL(Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF / Y' || WORK_YEAR || '_SALE_PROD_PROF * 100, 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_PROD @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_PROD_ST_O2
				]]>
			</isNotEqual>			
		</isEqual>
		<isNotEqual property="SEARCH_TYPE" compareValue="ODD">	
				<![CDATA[
				/*영업이익률 MAX*/
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_WF_SLS_PROF, 0) = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF/Y' || WORK_YEAR || '_SALE_WF_SLS_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_WF_ST_O1
				, LISTAGG(,NVL(((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF( Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0)) - ( Y' || WORK_YEAR || '_COO_COST_YR_COST / NULLIF( Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0))) / NULLIF((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF(Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_WF_ST_O2				
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_EQ_PROF, 0) = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF/Y' || WORK_YEAR || '_SALE_EQ_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_EQ_ST_O1				
				, LISTAGG(,NVL(((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF( Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0)) - ( Y' || WORK_YEAR || '_COO_COST_YR_COST / NULLIF( Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0))) / NULLIF((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF(Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_EQ_ST_O2				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_DIE_PROF, 0) = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF/Y' || WORK_YEAR || '_SALE_DIE_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_DIE_ST_O1				
				, LISTAGG(,NVL(((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF( Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0)) - ( Y' || WORK_YEAR || '_COO_COST_YR_COST / NULLIF( Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0))) / NULLIF((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF(Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_DIE_ST_O2				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(Y' || WORK_YEAR || '_SALE_PROD_PROF, 0) = 0 THEN 0 ELSE NVL(Y' || WORK_YEAR || '_SALES_PROF_PROD_PROF/Y' || WORK_YEAR || '_SALE_PROD_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_PROD_ST_O1				
				, LISTAGG(,NVL(((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF( Y' || WORK_YEAR || '_SOM_PROD_QTY_SALE_PLN, 0)) - ( Y' || WORK_YEAR || '_COO_COST_YR_COST / NULLIF( Y' || WORK_YEAR || '_SOM_PROD_QTY_SALE_PLN, 0))) / NULLIF((Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN / NULLIF(Y' || WORK_YEAR || '_SOM_PROD_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS Y' || WORK_YEAR || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_PROD_ST_O2				
				]]>
		</isNotEqual>				
				<![CDATA[
				/*연간 영업이익률*/
				, LISTAGG(', NVL(( Y' || WORK_YEAR || '_SALES_PROF_YR_PROF / NULLIF( Y' || WORK_YEAR || '_SALE_YR_PROF, 0)) * 100, 0) AS Y' || WORK_YEAR || '_COO_PROF_RATE_YR', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS COO_PROF_RATE_YR_ST_O
				, 4 AS SEQ
			FROM (
				SELECT WORK_YEAR FROM MAD_CALENDAR 
				WHERE WORK_YM >= #FROM_YM#
				AND WORK_YM <= #TO_YM#
				GROUP BY WORK_YEAR
			)	
			WHERE 'Y' = #DISPLAY_YEAR#	
			)
		]]>
		</select>
