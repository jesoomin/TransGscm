				, LISTAGG(,NVL(((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF( M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0)) - ( M' || WORK_YM || '_COO_COST_YR_COST / NULLIF( M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0))) / NULLIF((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF(M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS M' || WORK_YM || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_WF_ST_O2				
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(M' || WORK_YM || '_SALE_EQ_PROF, 0) = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALES_PROF_EQ_PROF/M' || WORK_YM || '_SALE_EQ_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_EQ_ST_O1				
				, LISTAGG(,NVL(((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF( M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0)) - ( M' || WORK_YM || '_COO_COST_YR_COST / NULLIF( M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0))) / NULLIF((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF(M' || WORK_YM || '_SOM_EQ_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS M' || WORK_YM || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_EQ_ST_O2				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(M' || WORK_YM || '_SALE_DIE_PROF, 0) = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALES_PROF_DIE_PROF/M' || WORK_YM || '_SALE_DIE_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_DIE_ST_O1				
				, LISTAGG(,NVL(((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF( M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0)) - ( M' || WORK_YM || '_COO_COST_YR_COST / NULLIF( M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0))) / NULLIF((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF(M' || WORK_YM || '_SOM_DIE_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS M' || WORK_YM || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_DIE_ST_O2				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN NVL(CASE WHEN NVL(M' || WORK_YM || '_SALE_PROD_PROF, 0) = 0 THEN 0 ELSE NVL(M' || WORK_YM || '_SALES_PROF_PROD_PROF/M' || WORK_YM || '_SALE_PROD_PROF * 100, 0) END, 0) = 0 THEN 0 ELSE @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_PROD_ST_O1				
				, LISTAGG(,NVL(((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF( M' || WORK_YM || '_SOM_PROD_QTY_SALE_PLN, 0)) - ( M' || WORK_YM || '_COO_COST_YR_COST / NULLIF( M' || WORK_YM || '_SOM_PROD_QTY_SALE_PLN, 0))) / NULLIF((M' || WORK_YM || '_SALE_AMT_SALE_PLN / NULLIF(M' || WORK_YM || '_SOM_PROD_QTY_SALE_PLN, 0)), 0) * 100 , 0) END AS M' || WORK_YM || '_COO_PROF_RATE_WF @', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_PROD_ST_O2				
				]]>
		</isNotEqual>				
				<![CDATA[
				/*연간 영업이익률*/
				, LISTAGG(', NVL(( M' || WORK_YM || '_SALES_PROF_YR_PROF / NULLIF( M' || WORK_YM || '_SALE_YR_PROF, 0)) * 100, 0) AS M' || WORK_YM || '_COO_PROF_RATE_YR', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS COO_PROF_RATE_YR_ST_O
				, 1 AS SEQ
			FROM (
				SELECT WORK_YM FROM MAD_CALENDAR 
				WHERE WORK_YM >= #FROM_YM#
				AND WORK_YM <= #TO_YM#
				GROUP BY WORK_YM
			)	
			WHERE 'Y' = #DISPLAY_MONTH#
			UNION ALL
					SELECT LISTAGG(',(''QUARTER'', ''' || WORK_YEAR_QUTR || ''') AS Q' || WORK_YEAR_QUTR, ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS PIVOT_STR
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CUM2_YLD_MASTER_DATA, 0) AS Q' || WORK_YEAR_QUTR || '_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CUM2_YLD_MASTER_DATA
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_ODD_CUM2_YLD_MASTER_DATA, 0) AS Q' || WORK_YEAR_QUTR || '_ODD_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ODD_CUM2_YLD_MASTER_DATA
				, LISTAGG(',NVL(TRIM(Q' || WORK_YEAR_QUTR || '_GOOD_DIE_MASTER_DATA), '' '') AS Q' || WORK_YEAR_QUTR || '_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS GOOD_DIE_MASTER_DATA
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_ODD_GOOD_DIE_MASTER_DATA, 0) AS Q' || WORK_YEAR_QUTR || '_ODD_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ODD_GOOD_DIE_MASTER_DATA
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN, 0) AS Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS WF_CONV_QTY_SALE_PLN
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN, 0) AS Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SOM_EQ_QTY_SALE_PLN
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN, 0) AS Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SOM_DIE_QTY_SALE_PLN
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN, 0) AS Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ORG_QTY_SALE_PLN
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_AMT_SALE_PLN
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_ASP_SALE_PLN, 0) AS Q' || WORK_YEAR_QUTR || '_ASP_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ASP_SALE_PLN
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_GRAV_SALE_PLN, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_GRAV_SALE_PLN
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_QTY_GRAV_SALE_PLN, 0) AS Q' || WORK_YEAR_QUTR || '_QTY_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS QTY_GRAV_SALE_PLN
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_GRAV_SALE_PLN, 0) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_GRAV_SALE_PLN
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_WF_SLS_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_WF_SLS_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_PROF_WF_SLS_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_WF_SLS_PROF				
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROF_WF_SLS_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_WF_SLS_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_WF_SLS_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_EQ_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_EQ_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_EQ_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_PROF_EQ_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_EQ_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROF_EQ_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_EQ_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_EQ_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_EQ_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_DIE_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_DIE_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_DIE_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_PROF_DIE_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_DIE_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROF_DIE_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_DIE_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_DIE_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_DIE_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROD_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_PROD_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_PROD_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_PROF_PROD_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_PROD_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROF_PROD_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_PROD_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_PROD_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_YR_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_YR_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_YR_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_YR_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_PROF_YR_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_YR_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROF_YR_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_YR_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_SALES_PROF_YR_PROF, 0) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_YR_PROF
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_VAR_COST_WF_SLS_COST, 0) AS Q' || WORK_YEAR_QUTR || '_VAR_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_WF_SLS_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_COST_WF_SLS_COST, 0) AS Q' || WORK_YEAR_QUTR || '_CASH_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_WF_SLS_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COGS_COST_WF_SLS_COST, 0) AS Q' || WORK_YEAR_QUTR || '_COGS_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_WF_SLS_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COO_COST_WF_SLS_COST, 0) AS Q' || WORK_YEAR_QUTR || '_COO_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_WF_SLS_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_VAR_COST_EQ_COST, 0) AS Q' || WORK_YEAR_QUTR || '_VAR_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_EQ_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_COST_EQ_COST, 0) AS Q' || WORK_YEAR_QUTR || '_CASH_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_EQ_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COGS_COST_EQ_COST, 0) AS Q' || WORK_YEAR_QUTR || '_COGS_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_EQ_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COO_COST_EQ_COST, 0) AS Q' || WORK_YEAR_QUTR || '_COO_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_EQ_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_VAR_COST_DIE_COST, 0) AS Q' || WORK_YEAR_QUTR || '_VAR_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_DIE_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_COST_DIE_COST, 0) AS Q' || WORK_YEAR_QUTR || '_CASH_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_DIE_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COGS_COST_DIE_COST, 0) AS Q' || WORK_YEAR_QUTR || '_COGS_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_DIE_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COO_COST_DIE_COST, 0) AS Q' || WORK_YEAR_QUTR || '_COO_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_DIE_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_VAR_COST_PROD_COST, 0) AS Q' || WORK_YEAR_QUTR || '_VAR_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_PROD_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_COST_PROD_COST, 0) AS Q' || WORK_YEAR_QUTR || '_CASH_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_PROD_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COGS_COST_PROD_COST, 0) AS Q' || WORK_YEAR_QUTR || '_COGS_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_PROD_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COO_COST_PROD_COST, 0) AS Q' || WORK_YEAR_QUTR || '_COO_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_PROD_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_VAR_COST_YR_COST, 0) AS Q' || WORK_YEAR_QUTR || '_VAR_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_YR_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_CASH_COST_YR_COST, 0) AS Q' || WORK_YEAR_QUTR || '_CASH_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_YR_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COGS_COST_YR_COST, 0) AS Q' || WORK_YEAR_QUTR || '_COGS_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_YR_COST
				, LISTAGG(',NVL(Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST, 0) AS Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_YR_COST
				/*영업이익률(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(', CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF,0) = 0 THEN 0 ELSE NVL( Q' || WORK_YEAR_QUTR || '_SALES_PROF_WF_SLS_PROF / Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF * 100, 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_WF
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(', CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF,0) = 0 THEN 0 ELSE NVL( Q' || WORK_YEAR_QUTR || '_SALES_PROF_EQ_PROF / Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF * 100, 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_EQ ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_EQ
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(', CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF,0) = 0 THEN 0 ELSE NVL( Q' || WORK_YEAR_QUTR || '_SALES_PROF_DIE_PROF / Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF * 100, 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_DIE ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_DIE
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(', CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF,0) = 0 THEN 0 ELSE NVL( Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF / Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF * 100, 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_PROD ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_PROD
				/*영업이익률(연간 영업이익 / 연간 매출액)*/
				, LISTAGG(', CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_SALE_YR_PROF,0) = 0 THEN 0 ELSE NVL( Q' || WORK_YEAR_QUTR || '_SALES_PROF_YR_PROF / Q' || WORK_YEAR_QUTR || '_SALE_YR_PROF * 100, 0) END AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_YR ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_YR
				
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CUM2_YLD_MASTER_DATA) AS Q' || WORK_YEAR_QUTR || '_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CUM2_YLD_MASTER_DATA_ST				
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_ODD_CUM2_YLD_MASTER_DATA) AS Q' || WORK_YEAR_QUTR || '_ODD_CUM2_YLD_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ODD_CUM2_YLD_MASTER_DATA_ST
				, LISTAGG(',MAX(Q' || WORK_YEAR_QUTR || '_GOOD_DIE_MASTER_DATA) AS Q' || WORK_YEAR_QUTR || '_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS GOOD_DIE_MASTER_DATA_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_ODD_GOOD_DIE_MASTER_DATA) AS Q' || WORK_YEAR_QUTR || '_ODD_GOOD_DIE_MASTER_DATA ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ODD_GOOD_DIE_MASTER_DATA_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN) AS Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS WF_CONV_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN) AS Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SOM_EQ_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN) AS Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SOM_DIE_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN) AS Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ORG_QTY_SALE_PLN_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN) AS Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_AMT_SALE_PLN_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_ASP_SALE_PLN) AS Q' || WORK_YEAR_QUTR || '_ASP_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ASP_SALE_PLN_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_GRAV_SALE_PLN) AS Q' || WORK_YEAR_QUTR || '_SALE_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_QTY_GRAV_SALE_PLN) AS Q' || WORK_YEAR_QUTR || '_QTY_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS QTY_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALES_PROF_GRAV_SALE_PLN) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_GRAV_SALE_PLN ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_GRAV_SALE_PLN_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF) AS Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_WF_SLS_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_WF_SLS_PROF) AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CASH_PROF_WF_SLS_PROF) AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_WF_SLS_PROF_ST				
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_PROF_WF_SLS_PROF) AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALES_PROF_WF_SLS_PROF) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_WF_SLS_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_WF_SLS_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF) AS Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_EQ_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_EQ_PROF) AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CASH_PROF_EQ_PROF) AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_PROF_EQ_PROF) AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALES_PROF_EQ_PROF) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_EQ_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_EQ_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF) AS Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_DIE_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_DIE_PROF) AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CASH_PROF_DIE_PROF) AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_PROF_DIE_PROF) AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALES_PROF_DIE_PROF) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_DIE_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_DIE_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF) AS Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROD_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_PROD_PROF) AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CASH_PROF_PROD_PROF) AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_PROF_PROD_PROF) AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_PROD_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_PROD_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_YR_PROF) AS Q' || WORK_YEAR_QUTR || '_SALE_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_YR_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_YR_PROF) AS Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_YR_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CASH_PROF_YR_PROF) AS Q' || WORK_YEAR_QUTR || '_CASH_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_YR_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALE_PROF_YR_PROF) AS Q' || WORK_YEAR_QUTR || '_SALE_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_YR_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_SALES_PROF_YR_PROF) AS Q' || WORK_YEAR_QUTR || '_SALES_PROF_YR_PROF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_YR_PROF_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_VAR_COST_WF_SLS_COST) AS Q' || WORK_YEAR_QUTR || '_VAR_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CASH_COST_WF_SLS_COST) AS Q' || WORK_YEAR_QUTR || '_CASH_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_COGS_COST_WF_SLS_COST) AS Q' || WORK_YEAR_QUTR || '_COGS_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_COO_COST_WF_SLS_COST) AS Q' || WORK_YEAR_QUTR || '_COO_COST_WF_SLS_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_WF_SLS_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_VAR_COST_EQ_COST) AS Q' || WORK_YEAR_QUTR || '_VAR_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_EQ_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CASH_COST_EQ_COST) AS Q' || WORK_YEAR_QUTR || '_CASH_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_EQ_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_COGS_COST_EQ_COST) AS Q' || WORK_YEAR_QUTR || '_COGS_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_EQ_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_COO_COST_EQ_COST) AS Q' || WORK_YEAR_QUTR || '_COO_COST_EQ_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_EQ_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_VAR_COST_DIE_COST) AS Q' || WORK_YEAR_QUTR || '_VAR_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_DIE_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CASH_COST_DIE_COST) AS Q' || WORK_YEAR_QUTR || '_CASH_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_DIE_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_COGS_COST_DIE_COST) AS Q' || WORK_YEAR_QUTR || '_COGS_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_DIE_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_COO_COST_DIE_COST) AS Q' || WORK_YEAR_QUTR || '_COO_COST_DIE_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_DIE_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_VAR_COST_PROD_COST) AS Q' || WORK_YEAR_QUTR || '_VAR_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_PROD_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CASH_COST_PROD_COST) AS Q' || WORK_YEAR_QUTR || '_CASH_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_PROD_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_COGS_COST_PROD_COST) AS Q' || WORK_YEAR_QUTR || '_COGS_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_PROD_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_COO_COST_PROD_COST) AS Q' || WORK_YEAR_QUTR || '_COO_COST_PROD_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_PROD_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_VAR_COST_YR_COST) AS Q' || WORK_YEAR_QUTR || '_VAR_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_YR_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_CASH_COST_YR_COST) AS Q' || WORK_YEAR_QUTR || '_CASH_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_YR_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_COGS_COST_YR_COST) AS Q' || WORK_YEAR_QUTR || '_COGS_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COGS_COST_YR_COST_ST
				, LISTAGG(',SUM(Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST) AS Q' || WORK_YEAR_QUTR || '_COO_COST_YR_COST ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_COST_YR_COST_ST
				/*영업이익률 MAX(장당 영업이익 / 장당 매출액)*/
				, LISTAGG(',MAX(Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF) AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_WF ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_WF_ST
				/*영업이익률(EQ 영업이익 / EQ 매출액)*/
				, LISTAGG(',MAX(Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_EQ) AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_EQ ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_EQ_ST				
				/*영업이익률(DIE 영업이익 / DIE 매출액)*/
				, LISTAGG(',MAX(Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_DIE) AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_DIE ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_DIE_ST				
				/*영업이익률(제품 영업이익 / 제품 매출액)*/
				, LISTAGG(',MAX(Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_PROD) AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_PROD ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_PROD_ST				
				/*영업이익률(연간 영업이익 / 연간 매출액)*/
				, LISTAGG(',MAX(Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_YR) AS Q' || WORK_YEAR_QUTR || '_COO_PROF_RATE_YR ', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS COO_PROF_RATE_YR_ST

				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_CUM2_YLD_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CUM2_YLD_MASTER_DATA_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_ODD_CUM2_YLD_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ODD_CUM2_YLD_MASTER_DATA_ST_O
				, LISTAGG(',CASE WHEN Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN = 0 THEN ''0'' ELSE CASE WHEN GRP_ID > 0 THEN TO_CHAR(Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN / Q' || WORK_YEAR_QUTR || '_GOOD_DIE_MASTER_DATA END END AS Q' || WORK_YEAR_QUTR || '_GOOD_DIE_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS GOOD_DIE_MASTER_DATA_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_ODD_GOOD_DIE_MASTER_DATA', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ODD_GOOD_DIE_MASTER_DATA_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS WF_CONV_QTY_SALE_PLN_ST_O				
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SOM_EQ_QTY_SALE_PLN_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SOM_DIE_QTY_SALE_PLN_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ORG_QTY_SALE_PLN_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_AMT_SALE_PLN_ST_O
				, LISTAGG(',CASE WHEN Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN, 0) END AS Q' || WORK_YEAR_QUTR || '_ASP_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS ASP_SALE_PLN_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_SALE_GRAV_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_GRAV_SALE_PLN_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_QTY_GRAV_SALE_PLN', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS QTY_GRAV_SALE_PLN_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_SALES_PROF_GRAV', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_GRAV_ST_O
				, LISTAGG(',CASE WHEN Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN, 0) END AS Q' || WORK_YEAR_QUTR || '_SALE_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_WF_SLS_PROF_ST_O
				, LISTAGG(',CASE WHEN Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / Q' || WORK_YEAR_QUTR || '_SOM_EQ_QTY_SALE_PLN, 0) END AS Q' || WORK_YEAR_QUTR || '_SALE_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / Q' || WORK_YEAR_QUTR || '_SOM_DIE_QTY_SALE_PLN, 0) END AS Q' || WORK_YEAR_QUTR || '_SALE_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_DIE_PROF_ST_O
				, LISTAGG(',CASE WHEN Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN = 0 THEN 0 ELSE NVL(Q' || WORK_YEAR_QUTR || '_SALE_AMT_SALE_PLN / Q' || WORK_YEAR_QUTR || '_ORG_QTY_SALE_PLN, 0) END AS Q' || WORK_YEAR_QUTR || '_SALE_PROD_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROD_PROF_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_SALE_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_YR_PROF_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_CNTRB_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CNTRB_PROF_YR_PROF_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_CASH_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_PROF_YR_PROF_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_SALE_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALE_PROF_YR_PROF_ST_O
				, LISTAGG(',Q' || WORK_YEAR_QUTR || '_SALES_PROF_YR_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS SALES_PROF_YR_PROF_ST_O
			]]>
	<isEqual property="SEARCH_TYPE" compareValue="ODD">
		<isEqual property="CHK_SUBTOTAL" compareValue="Y">		
			<![CDATA[
				/*장당 원가*/
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN Q' || WORK_YEAR_QUTR || '_VAR_COST_WF_SLS_COST ELSE CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE Q' || WORK_YEAR_QUTR || '_VAR_COST_YR_COST / Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN END END AS Q' || WORK_YEAR_QUTR || '_VAR_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS VAR_COST_WF_SLS_COST_ST_O
				, LISTAGG(',CASE WHEN GRP_ID = 0 THEN Q' || WORK_YEAR_QUTR || '_CASH_COST_WF_SLS_COST ELSE CASE WHEN NVL(Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 ELSE Q' || WORK_YEAR_QUTR || '_CASH_COST_YR_COST / Q' || WORK_YEAR_QUTR || '_WF_CONV_QTY_SALE_PLN END END AS Q' || WORK_YEAR_QUTR || '_CASH_COST_WF_SLS_COST', ' ') WITHIN GROUP (ORDER BY WORK_YEAR_QUTR) AS CASH_COST_WF_SLS_COST_ST_O
