				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_CASH_PROF_WF_SLS_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_CASH_COST_YR_COST) / Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_CASH_PROF_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_WF_SLS_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_SALE_PROF_WF_SLS_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_COGS_COST_YR_COST) / Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_SALE_PROF_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_WF_SLS_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_COO_COST_YR_COST) / Y' || WORK_YEAR || '_WF_CONV_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_SALES_PROF_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_WF_SLS_PROF_ST_O
				/*EQ 수익성*/
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_CNTRB_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_VAR_COST_YR_COST) / Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_CNTRB_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_CASH_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_CASH_COST_YR_COST) / Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_CASH_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_SALE_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_COGS_COST_YR_COST) / Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_SALE_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_EQ_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_COO_COST_YR_COST) / Y' || WORK_YEAR || '_SOM_EQ_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_SALES_PROF_EQ_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_EQ_PROF_ST_O
				/*DIE 수익성*/
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_CNTRB_PROF_DIE_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_VAR_COST_YR_COST) / Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_CNTRB_PROF_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CNTRB_PROF_DIE_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_CASH_PROF_DIE_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_CASH_COST_YR_COST) / Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_CASH_PROF_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS CASH_PROF_DIE_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_SALE_PROF_DIE_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_COGS_COST_YR_COST) / Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_SALE_PROF_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALE_PROF_DIE_PROF_ST_O
				, LISTAGG(',CASE WHEN NVL(Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF, 0) = 0 THEN 0 ELSE (Y' || WORK_YEAR || '_SALE_AMT_SALE_PLN - Y' || WORK_YEAR || '_COO_COST_YR_COST) / Y' || WORK_YEAR || '_SOM_DIE_QTY_SALE_PLN END END AS Y' || WORK_YEAR || '_SALES_PROF_DIE_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YEAR) AS SALES_PROF_DIE_PROF_ST_O
