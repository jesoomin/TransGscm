				$ORG_QTY_SALE_PLN_ST$
				$SALE_AMT_SALE_PLN_ST$
				$ASP_SALE_PLN_ST$
				$SALE_GRAV_SALE_PLN_ST$
				$QTY_GRAV_SALE_PLN_ST$
				$SALES_PROF_GRAV_ST$
				$SALE_WF_SLS_PROF_ST$
				$CNTRB_PROF_WF_SLS_PROF_ST$
				$CASH_PROF_WF_SLS_PROF_ST$
				$SALE_PROF_WF_SLS_PROF_ST$
				$SALES_PROF_WF_SLS_PROF_ST$
				$SALE_EQ_PROF_ST$
				$CNTRB_PROF_EQ_PROF_ST$
				$CASH_PROF_EQ_PROF_ST$
				$SALE_PROF_EQ_PROF_ST$
				$SALES_PROF_EQ_PROF_ST$
				$SALE_DIE_PROF_ST$
				$CNTRB_PROF_DIE_PROF_ST$
				$CASH_PROF_DIE_PROF_ST$
