				, LISTAGG(',CASE WHEN NVL(M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN, 0) = 0 THEN 0 WHEN NVL(M' || WORK_YM || '_CASH_PROF_WF_SLS_PROF, 0) = 0 THEN 0 ELSE (M' || WORK_YM || '_SALE_AMT_SALE_PLN - M' || WORK_YM || '_CASH_COST_YR_COST) / M' || WORK_YM || '_WF_CONV_QTY_SALE_PLN END END AS M' || WORK_YM || '_CASH_PROF_WF_SLS_PROF', ' ') WITHIN GROUP (ORDER BY WORK_YM) AS CASH_PROF_WF_SLS_PROF_ST_O
