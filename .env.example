# 로컬 개발 DB 연결 설정 예시. 실제 값은 .env(커밋 금지)에만 넣는다.
DB_KIND=oracle
DB_HOST=localhost
DB_PORT=1521
# Oracle은 SID 또는 SERVICE_NAME 중 하나로 접속한다 - 실제 값 확인 후 채울 것
DB_SID=
DB_SERVICE_NAME=
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# jdbc:oracle:thin:@${DB_HOST}:${DB_PORT}:${DB_SID}  또는
# jdbc:oracle:thin:@//${DB_HOST}:${DB_PORT}/${DB_SERVICE_NAME}
DB_JDBC_URL=

# LLM Gateway (사내 AI Talent Lab, Azure OpenAI 호환)
LLM_GATEWAY_BASE_URL=https://skax.ai-talentlab.com
LLM_GATEWAY_API_VERSION=2024-12-01-preview
LLM_GATEWAY_API_KEY=CHANGE_ME
LLM_GATEWAY_DEFAULT_MODEL=gpt-4.1
