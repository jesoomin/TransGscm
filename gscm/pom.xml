<?xml version="1.0" encoding="UTF-8"?>
<!--
  G-SCM 차세대 전환 TO-BE Maven 모듈. docs/07-tobe-structure.xlsx로 확정된 패키지 구조
  (com.skhynix.gscm.r.{p1}.{p2})를 그대로 담는다 - CLAUDE.md, docs/09-common-conventions.md 참고.

  화면별 골격/포팅 코드는 chatui(app.py/skeleton_gen.py/converters.py)가 생성해서
  이 모듈의 src/main/java, src/main/resources 아래에 직접 저장한다.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.skhynix.gscm</groupId>
    <artifactId>gscm</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>gscm</name>
    <description>G-SCM 차세대 전환 - 서버(Controller/Service/Store/Mapper) TO-BE 모듈</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-spring-boot.version>3.0.3</mybatis-spring-boot.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>

        <!-- 로컬 Oracle DB(RPLS_ADM, SID=xe) 연동용. 접속정보는 .env에만 둔다(CLAUDE.md). -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>gscm</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
